--========================================================
-- GET PLAYER CAR
--========================================================

local function getCar()
    local cars = workspace:FindFirstChild("Cars")

    if not cars then
        return nil
    end

    for _, car in ipairs(cars:GetChildren()) do
        if car:IsA("Model") then
            if car:GetAttribute("OwnerUserId") == lp.UserId then
                return car
            end
        end
    end

    return nil
end

--========================================================
-- NOCLIP
--========================================================

local function applyNoclip()
    local car = getCar()

    if car then
        for _, obj in ipairs(car:GetDescendants()) do
            if obj:IsA("BasePart") then
                obj.CanCollide = false
            end
        end
    end

    local character = lp.Character

    if character then
        for _, obj in ipairs(character:GetDescendants()) do
            if obj:IsA("BasePart") then
                obj.CanCollide = false
            end
        end
    end
end

--========================================================
-- FUEL / CAR RESPAWN CYCLE
--========================================================

task.spawn(function()
    while true do
        task.wait(0.5)

        if autoMoneyFarm then
            pcall(function()

                local car = getCar()

                if car then

                    local fuel = car:GetAttribute("Fuel")

                    if typeof(fuel) == "number"
                        and fuel < 4
                        and not cycleBusy then

                        cycleBusy = true

                        Packets.DespawnCar:Fire()

                        task.wait(2)

                        Packets.SpawnCar:Fire()

                        task.wait(4)

                        cycleBusy = false
                    end

                elseif not cycleBusy then

                    if tick() - lastRespawnTry > 12 then
                        lastRespawnTry = tick()
                        Packets.SpawnCar:Fire()
                    end
                end
            end)
        end
    end
end)

