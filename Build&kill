--========================================================
-- GROUND RAYCAST
--========================================================

local function getGroundPosition(position, car)
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude

    local ignore = {
        car
    }

    if lp.Character then
        table.insert(ignore, lp.Character)
    end

    params.FilterDescendantsInstances = ignore
    params.IgnoreWater = false

    local origin = position + Vector3.new(0, 45, 0)
    local direction = Vector3.new(0, -250, 0)

    local hit = workspace:Raycast(
        origin,
        direction,
        params
    )

    if hit and hit.Normal.Y > 0.5 then
        return hit.Position + Vector3.new(0, 4, 0)
    end

    return position
end

--========================================================
-- NORMAL AUTO DRIVE
--========================================================

local function driveForward(car)
    local ch = car.PrimaryPart

    if not ch then
        return
    end

    local pos = ch.Position

    -- Same forward-style ground detection as the original
    local forwardPoint = pos + Vector3.new(35, 0, 0)

    local target = getGroundPosition(
        forwardPoint,
        car
    )

    local to = target - pos

    local vel = ch.AssemblyLinearVelocity

    local h = Vector3.new(
        vel.X,
        0,
        vel.Z
    )

    local hd = Vector3.new(
        to.X,
        0,
        to.Z
    )

    local top = serverTop or 60

    local SPEED = math.min(
        top * 1.3,
        135
    )

    if hd.Magnitude < 0.1 then
        return
    end

    local vertical = math.clamp(
        to.Y * 2,
        -40,
        25
    )

    if h.Magnitude > 2
        and h.Unit:Dot(hd.Unit) < 0.3 then

        ch.AssemblyLinearVelocity =
            h * 0.85
            + Vector3.new(
                0,
                vertical,
                0
            )

    else

        ch.AssemblyLinearVelocity =
            hd.Unit * SPEED
            + Vector3.new(
                0,
                vertical,
                0
            )
    end
end

--========================================================
-- CIRCLE PHYSICS DRIVE
--========================================================

local function driveCircle(car, dt)
    local ch = car.PrimaryPart

    if not ch then
        return
    end

    local pos = ch.Position

    local top = serverTop or 60

    -- Keep roughly the same driving speed as Auto Drive.
    local SPEED = math.min(
        top * 1.3,
        135
    )

    -- Convert linear speed into angular speed.
    -- This means changing R doesn't make the car
    -- instantly teleport around the circle.
    local radius = math.max(
        circleRadius,
        1
    )

    local angularSpeed = SPEED / radius

    circleAngle += angularSpeed * dt

    -- Look ahead on the circle.
    local targetAngle =
        circleAngle + circleLookAhead

    local targetXZ =
        circleCenter
        + Vector3.new(
            math.cos(targetAngle) * radius,
            0,
            math.sin(targetAngle) * radius
        )

    -- Find the actual ground underneath
    -- the target point.
    local target = getGroundPosition(
        targetXZ,
        car
    )

    local to = target - pos

    local hd = Vector3.new(
        to.X,
        0,
        to.Z
    )

    if hd.Magnitude < 0.1 then
        return
    end

    local vel = ch.AssemblyLinearVelocity

    local h = Vector3.new(
        vel.X,
        0,
        vel.Z
    )

    local vertical = math.clamp(
        to.Y * 2,
        -40,
        25
    )

    -- Physics steering.
    -- No CFrame movement is used here.
    local desired =
        hd.Unit * SPEED

    if h.Magnitude > 2 then
        local alignment =
            h.Unit:Dot(hd.Unit)

        if alignment < 0.3 then
            desired =
                h * 0.85
        else
            desired =
                h:Lerp(
                    desired,
                    0.18
                )
        end
    end

    ch.AssemblyLinearVelocity =
        Vector3.new(
            desired.X,
            vertical,
            desired.Z
        )
end

--========================================================
-- MAIN VEHICLE PHYSICS
--========================================================

RunService.PostSimulation:Connect(function(dt)

    -- Circle can work independently.
    if circling then

        local car = getCar()

        if car and car.PrimaryPart then

            if farmOn then
                applyNoclip()
            end

            if not serverTop then
                serverTop =
                    car:GetAttribute("TopSpeed")
            end

            driveCircle(
                car,
                dt
            )
        end

        return
    end

    -- Normal auto drive
    if not farmOn then
        return
    end

    applyNoclip()

    local car = getCar()

    if not car then
        return
    end

    if not car.PrimaryPart then
        return
    end

    if not serverTop then
        serverTop =
            car:GetAttribute("TopSpeed")
    end

    driveForward(car)
end)

