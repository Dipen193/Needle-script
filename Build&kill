--------------------------------------------------
-- NOCLIP
--------------------------------------------------

local function applyNoclip()

    local car = getCar()

    if car then

        for _, p in ipairs(car:GetDescendants()) do

            if p:IsA("BasePart") then
                p.CanCollide = false
            end

        end
    end

    local character = lp.Character

    if character then

        for _, p in ipairs(character:GetDescendants()) do

            if p:IsA("BasePart") then
                p.CanCollide = false
            end

        end
    end
end

--------------------------------------------------
-- FUEL / CAR CYCLE
--------------------------------------------------

task.spawn(function()

    while true do

        task.wait(0.5)

        if farmOn then

            local car = getCar()

            if car and not cycleBusy then

                local fuel =
                    car:GetAttribute("Fuel")

                if type(fuel) == "number"
                    and fuel < 4 then

                    cycleBusy = true

                    pcall(function()
                        Packets.DespawnCar:Fire()
                    end)

                    task.wait(2)

                    pcall(function()
                        Packets.SpawnCar:Fire()
                    end)

                    task.wait(4)

                    cycleBusy = false
                end
            end

            --------------------------------------------------
            -- SPAWN CAR IF MISSING
            --------------------------------------------------

            if not getCar()
                and not cycleBusy
                and tick() - lastRespawnTry > 12 then

                lastRespawnTry = tick()

                pcall(function()
                    Packets.SpawnCar:Fire()
                end)
            end
        end
    end
end)

--------------------------------------------------
-- TURBO
--------------------------------------------------

task.spawn(function()

    while true do

        task.wait(0.3)

        if farmOn then

            pcall(function()
                Packets.SetTurbo:Fire(true)
            end)

            local car = getCar()

            if car then
                car:SetAttribute(
                    "NitroFuel",
                    1
                )
            end
        end
    end
end)

--------------------------------------------------
-- AUTO DRIVE
--------------------------------------------------

RunService.PostSimulation:Connect(function()

    if not farmOn then
        return
    end

    applyNoclip()

    local car = getCar()

    if not car or not car.PrimaryPart then
        return
    end

    local ch = car.PrimaryPart
    local pos = ch.Position

    --------------------------------------------------
    -- GET SERVER TOP SPEED
    --------------------------------------------------

    if not serverTop then

        local t =
            car:GetAttribute("TopSpeed")

        if type(t) == "number"
            and t > 0 then

            serverTop = t
        end
    end

    --------------------------------------------------
    -- GROUND RAYCAST
    --------------------------------------------------

    local rp = RaycastParams.new()

    rp.FilterType =
        Enum.RaycastFilterType.Exclude

    rp.FilterDescendantsInstances = {
        car,
        lp.Character
    }

    local hit = workspace:Raycast(

        Vector3.new(
            pos.X + 35,
            pos.Y + 40,
            pos.Z
        ),

        Vector3.new(
            0,
            -250,
            0
        ),

        rp
    )

    local target

    if hit and hit.Normal.Y > 0.5 then

        target =
            hit.Position +
            Vector3.new(0, 4, 0)

    else

        target =
            pos +
            Vector3.new(35, 0, 0)
    end

    --------------------------------------------------
    -- DIRECTION
    --------------------------------------------------

    local to =
        target - pos

    local vel =
        ch.AssemblyLinearVelocity

    local h =
        Vector3.new(
            vel.X,
            0,
            vel.Z
        )

    local hd =
        Vector3.new(
            to.X,
            0,
            to.Z
        )

    --------------------------------------------------
    -- SPEED
    --------------------------------------------------

    local SPEED =
        math.min(
            (serverTop or 60) * 1.3,
            135
        )

    --------------------------------------------------
    -- MOVEMENT
    --------------------------------------------------

    if h.Magnitude > 2
        and hd.Magnitude > 0.1
        and h.Unit:Dot(hd.Unit) < 0.3 then

        ch.AssemblyLinearVelocity =
            h * 0.85
            + Vector3.new(
                0,
                vel.Y,
                0
            )

    else

        ch.AssemblyLinearVelocity =
            hd.Unit * SPEED
            + Vector3.new(
                0,
                math.clamp(
                    to.Y * 2,
                    -40,
                    25
                ),
                0
            )
    end

    --------------------------------------------------
    -- STATUS
    --------------------------------------------------

    if tick() - lastDbg > 5 then

        lastDbg = tick()

        local fuel =
            car:GetAttribute("Fuel")

        local cv =
            lp:FindFirstChild("CashValue")

        status.Text =
            string.format(
                "DRIVE: ON\nFuel: %s | Cash: %s",
                tostring(fuel or "?"),
                cv and tostring(cv.Value)
                    or "?"
            )
    end
end)

--------------------------------------------------
-- CIRCLE START
--------------------------------------------------

local function startCircle()

    local character =
        lp.Character

    local root =
        character
        and character:FindFirstChild(
            "HumanoidRootPart"
        )

    if not root then

        status.Text =
            "Character not found"

        return
    end

    circling = true
    circleAngle = 0

    circleButton.Text =
        "CIRCLE: ON"

    circleButton.BackgroundColor3 =
        Color3.fromRGB(45, 150, 70)

    status.Text =
        "CIRCLE: ON\nRadius: " ..
        tostring(circleRadius)

    circleConnection =
        RunService.Heartbeat:Connect(
            function(dt)

                if not circling then
                    return
                end

                if not root
                    or not root.Parent then

                    return
                end

                --------------------------------------------------
                -- UPDATE ANGLE
                --------------------------------------------------

                circleAngle +=
                    dt * circleSpeed

                --------------------------------------------------
                -- CIRCLE POSITION
                --------------------------------------------------

                local offsetX =
                    math.cos(circleAngle)
                    * circleRadius

                local offsetZ =
                    math.sin(circleAngle)
                    * circleRadius

                local position =
                    circleCenter
                    + Vector3.new(
                        offsetX,
                        0,
                        offsetZ
                    )

                --------------------------------------------------
                -- FACE CENTER
                --------------------------------------------------

                root.CFrame =
                    CFrame.lookAt(
                        position,
                        circleCenter
                    )
            end
        )
end

--------------------------------------------------
-- CIRCLE STOP
--------------------------------------------------

local function stopCircle()

    circling = false

    if circleConnection then

        circleConnection:Disconnect()
        circleConnection = nil

    end

    circleButton.Text =
        "CIRCLE: OFF"

    circleButton.BackgroundColor3 =
        Color3.fromRGB(70, 70, 150)

    status.Text = "Circle stopped"
end

