RunService.PostSimulation:Connect(function(dt)

    if bossFarm then

        local car = getCar()

        if not car then
            setBossStatus("NO CAR")
            return
        end

        if not car.PrimaryPart then
            setBossStatus("CAR LOADING")
            return
        end

        if not serverTop then
            serverTop = car:GetAttribute("TopSpeed")
        end

        applyNoclip()

        runZeusBossDrive(car, dt)

        return
    end

    if not autoMoneyFarm then
        return
    end

    applyNoclip()

    local car = getCar()

    if not car then
        return
    end

    if not car.PrimaryPart then
        return
    end

    if not serverTop then
        serverTop = car:GetAttribute("TopSpeed")
    end

    driveForward(car)
end)


RunService.PostSimulation:Connect(function(dt)

    if bossFarm then

        local car = getCar()

        if not car then
            return
        end

        if not car.PrimaryPart then
            return
        end

        if not serverTop then
            serverTop =
                car:GetAttribute("TopSpeed")
        end

        if autoMoneyFarm then
            applyNoclip()
        end

        driveCircle(
            car,
            dt
        )

        return
    end

    if not autoMoneyFarm then
        return
    end

    applyNoclip()

    local car = getCar()

    if not car then
        return
    end

    if not car.PrimaryPart then
        return
    end

    if not serverTop then
        serverTop =
            car:GetAttribute("TopSpeed")
    end

    driveForward(car)
end)

