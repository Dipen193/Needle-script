--------------------------------------------------
-- GET PLAYER CAR
--------------------------------------------------

local function getCar()

    local cars = workspace:FindFirstChild("Cars")

    if not cars then
        return nil
    end

    for _, c in ipairs(cars:GetChildren()) do

        if c:IsA("Model")
            and c:GetAttribute("OwnerUserId") == lp.UserId then

            return c
        end
    end

    return nil
end

