    ------------------------------------------------------
    local circleCenter = Vector3.new(-1624.734, 15.484, -656.456)
    local circleRadius = 40
    local circleLookAhead = 0.35

    -- DRIVE SPEED (controlled by the Drive Speed slider)
    local driveSpeedMultiplier = 1.30
    local maxActualSpeed = 200

    local ZEUS_ARENA_CENTER = circleCenter
    local ZEUS_ARENA_RADIUS = 75
    local ZEUS_FUEL_RADIUS = 75
    local FUEL_PICKUP_DISTANCE = 7

    local dodgeDistance = 24
    local dodgeTime = 0.75
    local dodgeCooldown = 1.0

    local zeusAttackActive = false
    local zeusAttackUntil = 0
    local lastDodge = 0
    local statusLabel = nil

    ------------------------------------------------------
    -- STATE
    ------------------------------------------------------
    local autoMoneyFarm = false
    local bossFarm = false
    local antiAFK = false

    local cycleBusy = false
    local serverTop = nil
    local lastRespawnTry = 0
    local circleAngle = 0

    ------------------------------------------------------
    -- PACKETS (safe: will not hang the GUI if missing)
    ------------------------------------------------------
    local Packets = nil

    pcall(function()
        local pk = RS:WaitForChild("Packages", 5)
