circleButton.MouseButton1Click:Connect(function()

    circling = not circling

    if circling then

        -- Start from the car's current position
        -- instead of instantly jumping to angle 0.
        local car = getCar()

        if car and car.PrimaryPart then
            local offset =
                car.PrimaryPart.Position
                - circleCenter

            if offset.X ~= 0
                or offset.Z ~= 0 then

                circleAngle =
                    math.atan2(
                        offset.Z,
                        offset.X
                    )
            end
        end

        circleButton.Text = "ON"
        circleButton.BackgroundColor3 =
            COLORS.on

        statusLabel.Text =
            "CIRCLE: ON\nRadius: "
            .. math.floor(circleRadius)

    else

        circleButton.Text = "OFF"
        circleButton.BackgroundColor3 =
            COLORS.off

        statusLabel.Text =
            "CIRCLE: OFF\nRadius: "
            .. math.floor(circleRadius)
    end
end)

