--========================================================
-- GROUND RAYCAST
--========================================================

local function getGroundPosition(position, car)

    local params = RaycastParams.new()

    params.FilterType =
        Enum.RaycastFilterType.Exclude

    local ignore = {
        car
    }

    if lp.Character then
        table.insert(
            ignore,
            lp.Character
        )
    end

    params.FilterDescendantsInstances =
        ignore

    params.IgnoreWater = false

    local origin =
        position + Vector3.new(0, 45, 0)

    local direction =
        Vector3.new(0, -250, 0)

    local hit =
        workspace:Raycast(
            origin,
            direction,
            params
        )

    if hit and hit.Normal.Y > 0.5 then
        return hit.Position +
            Vector3.new(0, 4, 0)
    end

    return position
end

--========================================================
-- NORMAL AUTO DRIVE
--========================================================

local function driveForward(car)

    local ch = car.PrimaryPart

    if not ch then
        return
    end

    local pos = ch.Position

    local forwardPoint =
        pos + Vector3.new(35, 0, 0)

    local target =
        getGroundPosition(
            forwardPoint,
            car
        )

    local to =
        target - pos

    local vel =
        ch.AssemblyLinearVelocity

    local h =
        Vector3.new(
            vel.X,
            0,
            vel.Z
        )

    local hd =
        Vector3.new(
            to.X,
            0,
            to.Z
        )

    if hd.Magnitude < 0.1 then
        return
    end

    local top =
        serverTop or 60

    local SPEED =
        math.min(
            top * 1.3,
            135
        )

    local vertical =
        math.clamp(
            to.Y * 2,
            -40,
            25
        )

    if h.Magnitude > 2
        and h.Unit:Dot(hd.Unit) < 0.3 then

        ch.AssemblyLinearVelocity =
            h * 0.85
            + Vector3.new(
                0,
                vertical,
                0
            )

    else

        ch.AssemblyLinearVelocity =
            hd.Unit * SPEED
            + Vector3.new(
                0,
                vertical,
                0
            )
    end
end

--========================================================
-- PHYSICS CIRCLE DRIVE
--========================================================

local function driveCircle(car, dt)

    local ch = car.PrimaryPart

    if not ch then
        return
    end

    local pos = ch.Position

    local top =
        serverTop or 60

    local SPEED =
        math.min(
            top * 1.3,
            135
        )

    local radius =
        math.max(
            circleRadius,
            1
        )

    local angularSpeed =
        SPEED / radius

    circleAngle +=
        angularSpeed * dt

    local targetAngle =
        circleAngle + circleLookAhead

    local targetXZ =
        circleCenter +
        Vector3.new(
            math.cos(targetAngle) * radius,
            0,
            math.sin(targetAngle) * radius
        )

    local target =
        getGroundPosition(
            targetXZ,
            car
        )

    local to =
        target - pos

    local hd =
        Vector3.new(
            to.X,
            0,
            to.Z
        )

    if hd.Magnitude < 0.1 then
        return
    end

    local vel =
        ch.AssemblyLinearVelocity

    local h =
        Vector3.new(
            vel.X,
            0,
            vel.Z
        )

    local vertical =
        math.clamp(
            to.Y * 2,
            -40,
            25
        )

    local desired =
        hd.Unit * SPEED

    if h.Magnitude > 2 then

        local alignment =
            h.Unit:Dot(hd.Unit)

        if alignment < 0.3 then
            desired = h * 0.85
        else
            desired =
                h:Lerp(
                    desired,
                    0.18
                )
        end
    end

    ch.AssemblyLinearVelocity =
        Vector3.new(
            desired.X,
            vertical,
            desired.Z
        )
end

--========================================================
-- ZEUS BOSS HELPERS
--========================================================

local function flatDistance(a, b)
    local dx = a.X - b.X
    local dz = a.Z - b.Z
    return math.sqrt(dx * dx + dz * dz)
end

local function getZeus()
    local bosses = workspace:FindFirstChild("ClientBosses")
    if not bosses then
        return nil
    end

    local zeus = bosses:FindFirstChild("ZeusBoss")
    if zeus and zeus:IsA("Model") then
        return zeus
    end

    return nil
end

local function getModelPosition(model)
    if not model then
        return nil
    end

    if model:IsA("BasePart") then
        return model.Position
    end

    if model:IsA("Model") then
        if model.PrimaryPart then
            return model.PrimaryPart.Position
        end

        local root = model:FindFirstChild("HumanoidRootPart", true)
        if root and root:IsA("BasePart") then
            return root.Position
        end

        local part = model:FindFirstChildWhichIsA("BasePart", true)
        if part then
            return part.Position
        end
    end

    return nil
end

-- IMPORTANT:
-- Only ClientBosses.RefillFuel is considered valid Zeus fuel.
-- Generic FuelBarrel / ProFuel objects elsewhere are ignored.
local function getZeusFuel()
    local bosses = workspace:FindFirstChild("ClientBosses")
    if not bosses then
        return nil
    end

    local refill = bosses:FindFirstChild("RefillFuel")
    if not refill then
        return nil
    end

    local fuelModel = refill:FindFirstChild("FuelModel")
    if fuelModel then
        return fuelModel
    end

    -- Fallback only if the game temporarily replaces FuelModel
    -- with a BasePart directly under RefillFuel.
    if refill:IsA("BasePart") then
        return refill
    end

    return nil
end

local function getFuelPosition()
    local fuel = getZeusFuel()
    local pos = getModelPosition(fuel)

    if not pos then
        return nil, nil
    end

    if flatDistance(pos, ZEUS_ARENA_CENTER) > ZEUS_FUEL_RADIUS then
        return nil, nil
    end

    return fuel, pos
end

local function isInsideZeusArena(position)
    return flatDistance(position, ZEUS_ARENA_CENTER) <= ZEUS_ARENA_RADIUS
end

local function setBossStatus(value)
    bossStatus = value

    if statusLabel and statusLabel.Parent then
        statusLabel.Text = "STATUS: " .. value
    end
end

local function getCarSpeed(car)
    local top = car:GetAttribute("TopSpeed")

    if typeof(top) ~= "number" then
        top = serverTop or 60
    end

    return math.min(top * 1.3, 135)
end

local function driveTowardPosition(car, targetPosition, speedMultiplier)
    local ch = car and car.PrimaryPart
    if not ch then
        return false
    end

    local pos = ch.Position
    local target = getGroundPosition(targetPosition, car)

    local to = target - pos
    local horizontal = Vector3.new(to.X, 0, to.Z)

    if horizontal.Magnitude < 0.1 then
        return true
    end

    local speed = getCarSpeed(car) * (speedMultiplier or 1)

    local vel = ch.AssemblyLinearVelocity
    local horizontalVel = Vector3.new(vel.X, 0, vel.Z)

    local desired = horizontal.Unit * speed

    -- Smooth turns so the car does not make violent direction changes.
    if horizontalVel.Magnitude > 2 then
        local alignment = horizontalVel.Unit:Dot(horizontal.Unit)

        if alignment < 0.15 then
            desired = horizontalVel * 0.78
        else
            desired = horizontalVel:Lerp(desired, 0.22)
        end
    end

    local vertical = math.clamp(to.Y * 2, -40, 25)

    ch.AssemblyLinearVelocity = Vector3.new(
        desired.X,
        vertical,
        desired.Z
    )

    return false
end

local function stopCar(car)
    local ch = car and car.PrimaryPart
    if not ch then
        return
    end

    local v = ch.AssemblyLinearVelocity

    ch.AssemblyLinearVelocity = Vector3.new(
        v.X * 0.65,
        v.Y,
        v.Z * 0.65
    )
end

-- Keep the dodge inside the same Zeus arena.
-- We never use "directly away from Zeus" without clamping the destination.
local function getSafeDodgePoint(car, zeus)
    local ch = car and car.PrimaryPart
    local bossPos = getModelPosition(zeus)

    if not ch or not bossPos then
        return ZEUS_ARENA_CENTER
    end

    local carPos = ch.Position
    local away = Vector3.new(
        carPos.X - bossPos.X,
        0,
        carPos.Z - bossPos.Z
    )

    if away.Magnitude < 0.1 then
        away = Vector3.new(1, 0, 0)
    end

    away = away.Unit

    local desired = carPos + away * dodgeDistance

    local fromCenter = Vector3.new(
        desired.X - ZEUS_ARENA_CENTER.X,
        0,
        desired.Z - ZEUS_ARENA_CENTER.Z
    )

    -- Leave a safety margin from the arena boundary.
    local maxRadius = math.max(ZEUS_ARENA_RADIUS - 8, 1)

    if fromCenter.Magnitude > maxRadius then
        fromCenter = fromCenter.Unit * maxRadius
    end

    return Vector3.new(
        ZEUS_ARENA_CENTER.X + fromCenter.X,
        desired.Y,
        ZEUS_ARENA_CENTER.Z + fromCenter.Z
    )
end

-- Attack monitor:
-- We watch only ClientBosses instead of scanning the entire Workspace
-- every physics frame. The exact runtime VFX names are game-dependent,
-- so these are treated as candidate attack effects.
local attackNames = {
    ThunderstormStrike = true,
    LightningSpearBlast = true,
    LightningSpearScorch = true,
    OlympusSlamImpact = true,
    BoltDrawStrike = true,
    IntroLandingStrike = true,
    MinionSpawnStrike = true,
    ThunderstormVFX = true,
    LightningSpearVFX = true,
    OlympusSlamVFX = true,
    SummonVFX = true,
}

local function markPossibleZeusAttack(obj)
    if not bossFarm then
        return
    end

    if not obj then
        return
    end

    if attackNames[obj.Name] then
        zeusAttackActive = true
        zeusAttackUntil = math.max(
            zeusAttackUntil,
            tick() + dodgeTime
        )
    end
end

local function attachZeusMonitor()
    local bosses = workspace:FindFirstChild("ClientBosses")
    if not bosses then
        return
    end

    -- Only one monitor connection is needed.
    if bosses:GetAttribute("_BK_ZeusMonitor") then
        return
    end

    bosses:SetAttribute("_BK_ZeusMonitor", true)

    bosses.DescendantAdded:Connect(function(obj)
        markPossibleZeusAttack(obj)
    end)
end

attachZeusMonitor()

workspace.ChildAdded:Connect(function(obj)
    if obj.Name == "ClientBosses" then
        task.defer(attachZeusMonitor)
    end
end)

local function driveBackIntoArena(car)
    local ch = car and car.PrimaryPart
    if not ch then
        return
    end

    local pos = ch.Position
    local offset = Vector3.new(
        pos.X - ZEUS_ARENA_CENTER.X,
        0,
        pos.Z - ZEUS_ARENA_CENTER.Z
    )

    if offset.Magnitude < 0.1 then
        driveTowardPosition(car, ZEUS_ARENA_CENTER, 0.7)
        return
    end

    local safeRadius = math.max(ZEUS_ARENA_RADIUS - 12, 1)

    if offset.Magnitude > safeRadius then
        local targetOffset = offset.Unit * safeRadius
        local target = Vector3.new(
            ZEUS_ARENA_CENTER.X + targetOffset.X,
            pos.Y,
            ZEUS_ARENA_CENTER.Z + targetOffset.Z
        )

        setBossStatus("RETURNING")
        driveTowardPosition(car, target, 0.75)
    end
end

local function runZeusBossDrive(car, dt)
    local zeus = getZeus()

    if not zeus then
        setBossStatus("WAITING FOR ZEUS")
        -- Do not wander while Zeus is absent.
        stopCar(car)
        return
    end

    local carPos = car.PrimaryPart.Position

    -- Hard arena safety check comes first.
    if not isInsideZeusArena(carPos) then
        driveBackIntoArena(car)
        return
    end

    -- Candidate attack detected.
    if zeusAttackActive and tick() <= zeusAttackUntil then
        if tick() - lastDodge >= dodgeCooldown then
            lastDodge = tick()
        end

        setBossStatus("DODGE")
        local dodgePoint = getSafeDodgePoint(car, zeus)
        driveTowardPosition(car, dodgePoint, 0.95)
        return
    end

    if tick() > zeusAttackUntil then
        zeusAttackActive = false
    end

    -- FUEL ALWAYS HAS PRIORITY over circling.
    local fuel, fuelPos = getFuelPosition()

    if fuel and fuelPos then
        local distance = flatDistance(carPos, fuelPos)

        if distance <= FUEL_PICKUP_DISTANCE then
            setBossStatus("FUEL PICKUP")
            stopCar(car)
        else
            setBossStatus("FUEL")
            driveTowardPosition(car, fuelPos, 0.9)
        end

        return
    end

    -- No fuel target: stay in the Zeus arena and circle.
    setBossStatus("CIRCLE")
    driveCircle(car, dt)
end

