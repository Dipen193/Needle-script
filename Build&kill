            pcall(function()
                VirtualUser:CaptureController()
                VirtualUser:ClickButton2(Vector2.new(0, 0))
            end)
        end
    end)

    ------------------------------------------------------
    -- GROUND RAYCAST
    ------------------------------------------------------
    local function getGroundPosition(position, car)
        local params = RaycastParams.new()
        params.FilterType = Enum.RaycastFilterType.Exclude

        local ignore = {car}

        if lp.Character then
            table.insert(ignore, lp.Character)
        end

        params.FilterDescendantsInstances = ignore
        params.IgnoreWater = false

        local hit = workspace:Raycast(
            position + Vector3.new(0, 45, 0),
            Vector3.new(0, -250, 0),
            params
        )

        if hit and hit.Normal.Y > 0.5 then
            return hit.Position + Vector3.new(0, 4, 0)
        end

        return position
    end

    ------------------------------------------------------
    -- CURRENT DRIVE SPEED
    ------------------------------------------------------
    local function getDriveSpeed(car)
        local top = serverTop

        if not top then
            top = car:GetAttribute("TopSpeed")

            if typeof(top) == "number" then
                serverTop = top
            else
                top = 60
            end
        end

        return math.min(top * driveSpeedMultiplier, maxActualSpeed)
    end

    ------------------------------------------------------
    -- NORMAL AUTO DRIVE
    ------------------------------------------------------
    local function driveForward(car)
        local ch = car.PrimaryPart
        if not ch then return end

        local pos = ch.Position
        local target = getGroundPosition(pos + Vector3.new(35, 0, 0), car)
        local to = target - pos

        local vel = ch.AssemblyLinearVelocity
        local h = Vector3.new(vel.X, 0, vel.Z)
        local hd = Vector3.new(to.X, 0, to.Z)

        if hd.Magnitude < 0.1 then return end

        local SPEED = getDriveSpeed(car)
        local vertical = math.clamp(to.Y * 2, -40, 25)

        if h.Magnitude > 2 and h.Unit:Dot(hd.Unit) < 0.3 then
            ch.AssemblyLinearVelocity =
                h * 0.85 + Vector3.new(0, vertical, 0)
        else
            ch.AssemblyLinearVelocity =
                hd.Unit * SPEED + Vector3.new(0, vertical, 0)
        end
    end

    ------------------------------------------------------
    -- PHYSICS CIRCLE DRIVE
    ------------------------------------------------------
    local function driveCircle(car, dt)
        local ch = car.PrimaryPart
        if not ch then return end

        local pos = ch.Position
        local SPEED = getDriveSpeed(car)
        local radius = math.max(circleRadius, 1)

        circleAngle += (SPEED / radius) * dt

        local targetAngle = circleAngle + circleLookAhead

        local targetXZ = circleCenter + Vector3.new(
            math.cos(targetAngle) * radius,
            0,
            math.sin(targetAngle) * radius
        )

        local target = getGroundPosition(targetXZ, car)
        local to = target - pos
        local hd = Vector3.new(to.X, 0, to.Z)

        if hd.Magnitude < 0.1 then return end

        local vel = ch.AssemblyLinearVelocity
        local h = Vector3.new(vel.X, 0, vel.Z)
        local vertical = math.clamp(to.Y * 2, -40, 25)
        local desired = hd.Unit * SPEED

        if h.Magnitude > 2 then
            local alignment = h.Unit:Dot(hd.Unit)

            if alignment < 0.3 then
                desired = h * 0.85
            else
                desired = h:Lerp(desired, 0.18)
            end
        end

        ch.AssemblyLinearVelocity =
            Vector3.new(desired.X, vertical, desired.Z)
    end

    ------------------------------------------------------
    -- ZEUS BOSS HELPERS
    ------------------------------------------------------
    local function flatDistance(a, b)
        local dx = a.X - b.X
        local dz = a.Z - b.Z
        return math.sqrt(dx * dx + dz * dz)
    end

    local function getZeus()
        local bosses = workspace:FindFirstChild("ClientBosses")
        if not bosses then return nil end

        local zeus = bosses:FindFirstChild("ZeusBoss")
        if zeus and zeus:IsA("Model") then
            return zeus
        end

        return nil
    end

    local function getModelPosition(model)
        if not model then return nil end

        if model:IsA("BasePart") then
            return model.Position
        end

        if model:IsA("Model") then
            if model.PrimaryPart then
                return model.PrimaryPart.Position
            end

            local root = model:FindFirstChild("HumanoidRootPart", true)
            if root and root:IsA("BasePart") then
                return root.Position
            end

            local part = model:FindFirstChildWhichIsA("BasePart", true)
            if part then
                return part.Position
            end
        end

        return nil
    end

    -- Only ClientBosses.RefillFuel is valid Zeus fuel.
    local function getZeusFuel()
        local bosses = workspace:FindFirstChild("ClientBosses")
        if not bosses then return nil end

        local refill = bosses:FindFirstChild("RefillFuel")
        if not refill then return nil end

        local fuelModel = refill:FindFirstChild("FuelModel")
        if fuelModel then return fuelModel end

        if refill:IsA("BasePart") then return refill end

        return nil
    end

    local function getFuelPosition()
        local fuel = getZeusFuel()
        local pos = getModelPosition(fuel)

        if not pos then return nil, nil end

        if flatDistance(pos, ZEUS_ARENA_CENTER) > ZEUS_FUEL_RADIUS then
            return nil, nil
        end

        return fuel, pos
    end

    local function isInsideZeusArena(position)
        return flatDistance(position, ZEUS_ARENA_CENTER) <= ZEUS_ARENA_RADIUS
    end

    local function setBossStatus(value)
        if statusLabel and statusLabel.Parent then
            statusLabel.Text = "STATUS: " .. value
        end
    end

    local function getCarSpeed(car)
        return getDriveSpeed(car)
    end

    local function driveTowardPosition(car, targetPosition, speedMultiplier)
        local ch = car and car.PrimaryPart
        if not ch then return false end

        local pos = ch.Position
        local target = getGroundPosition(targetPosition, car)
        local to = target - pos
        local horizontal = Vector3.new(to.X, 0, to.Z)

        if horizontal.Magnitude < 0.1 then return true end

        local speed = getCarSpeed(car) * (speedMultiplier or 1)
        local vel = ch.AssemblyLinearVelocity
        local horizontalVel = Vector3.new(vel.X, 0, vel.Z)
        local desired = horizontal.Unit * speed

        if horizontalVel.Magnitude > 2 then
            local alignment = horizontalVel.Unit:Dot(horizontal.Unit)

            if alignment < 0.15 then
                desired = horizontalVel * 0.78
            else
                desired = horizontalVel:Lerp(desired, 0.22)
            end
        end

        local vertical = math.clamp(to.Y * 2, -40, 25)

        ch.AssemblyLinearVelocity =
            Vector3.new(desired.X, vertical, desired.Z)

        return false
    end

    local function stopCar(car)
        local ch = car and car.PrimaryPart
        if not ch then return end

        local v = ch.AssemblyLinearVelocity
        ch.AssemblyLinearVelocity = Vector3.new(v.X * 0.65, v.Y, v.Z * 0.65)
    end

    local function getSafeDodgePoint(car, zeus)
        local ch = car and car.PrimaryPart
        local bossPos = getModelPosition(zeus)

        if not ch or not bossPos then
            return ZEUS_ARENA_CENTER
        end

        local carPos = ch.Position
        local away = Vector3.new(carPos.X - bossPos.X, 0, carPos.Z - bossPos.Z)

        if away.Magnitude < 0.1 then
            away = Vector3.new(1, 0, 0)
        end

        away = away.Unit

        local desired = carPos + away * dodgeDistance

        local fromCenter = Vector3.new(
            desired.X - ZEUS_ARENA_CENTER.X,
            0,
            desired.Z - ZEUS_ARENA_CENTER.Z
        )

        local maxRadius = math.max(ZEUS_ARENA_RADIUS - 8, 1)

        if fromCenter.Magnitude > maxRadius then
            fromCenter = fromCenter.Unit * maxRadius
        end

        return Vector3.new(
            ZEUS_ARENA_CENTER.X + fromCenter.X,
            desired.Y,
            ZEUS_ARENA_CENTER.Z + fromCenter.Z
        )
    end

    local attackNames = {
        ThunderstormStrike = true,
        LightningSpearBlast = true,
        LightningSpearScorch = true,
        OlympusSlamImpact = true,
        BoltDrawStrike = true,
        IntroLandingStrike = true,
        MinionSpawnStrike = true,
        ThunderstormVFX = true,
        LightningSpearVFX = true,
        OlympusSlamVFX = true,
        SummonVFX = true,
    }

    local function markPossibleZeusAttack(obj)
        if not bossFarm or not obj then return end

        if attackNames[obj.Name] then
            zeusAttackActive = true
            zeusAttackUntil = math.max(zeusAttackUntil, tick() + dodgeTime)
        end
    end

    local function attachZeusMonitor()
        local bosses = workspace:FindFirstChild("ClientBosses")
        if not bosses then return end

        if bosses:GetAttribute("_BK_ZeusMonitor") then return end

        bosses:SetAttribute("_BK_ZeusMonitor", true)

