        "STATUS: OFF",
        13,
        WHITE,
        UDim2.fromOffset(16, 128),
        UDim2.new(1, -32, 0, 22),
        Enum.Font.GothamBold
    )

    label(
        homeCard,
        "Radius",
        14,
        WHITE,
        UDim2.fromOffset(16, 166),
        UDim2.fromOffset(60, 36),
        Enum.Font.GothamBold
    )

    local radiusValue = label(
        homeCard,
        tostring(circleRadius),
