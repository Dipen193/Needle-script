            if not car.PrimaryPart then
                setBossStatus("CAR LOADING")
                return
            end

            if not serverTop then
                serverTop = car:GetAttribute("TopSpeed")
            end

            applyNoclip()
            runZeusBossDrive(car, dt)

            return
        end

        if not autoMoneyFarm then return end

        applyNoclip()

        local car = getCar()
        if not car or not car.PrimaryPart then return end

        if not serverTop then
            serverTop = car:GetAttribute("TopSpeed")
        end

        driveForward(car)
    end)

    ------------------------------------------------------
    -- HOME TAB UI
    ------------------------------------------------------
    local _, setAutoMoney = makeToggle(
        homeCard,
        "Auto Money Farm  (T)",
        1,
        function(on)
            autoMoneyFarm = on
        end
    )

    makeToggle(
        homeCard,
        "Boss Farm",
        2,
        function(on)
            bossFarm = on
