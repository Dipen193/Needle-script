                local car = getCar()

                if car and car.PrimaryPart then
                    -- Start the angle relative to Zeus' CURRENT position.
                    local center = circleCenter
                    local zeus = getZeus()
                    local zeusPos = zeus and getModelPosition(zeus)
                    if zeusPos then
                        center = Vector3.new(zeusPos.X, circleCenter.Y, zeusPos.Z)
                        circleCenter = center
                    end

                    local offset = car.PrimaryPart.Position - center
                    if offset.X ~= 0 or offset.Z ~= 0 then
                        circleAngle = math.atan2(offset.Z, offset.X)
                    end
                end
            else
                setBossStatus("OFF")
            end
        end
    )

    makeToggle(
        homeCard,
        "Anti AFK",
        3,
        function(on)
            antiAFK = on
        end
    )

    statusLabel = label(
