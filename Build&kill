local function addCorner(parent, radius)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, radius or 12)
    c.Parent = parent
    return c
end

local function addStroke(parent, color, thickness)
    local s = Instance.new("UIStroke")
    s.Color = color or COLORS.panelStroke
    s.Thickness = thickness or 3
    s.Parent = parent
    return s
end

local function addTextStroke(label)
    local s = Instance.new("UIStroke")
    s.Color = Color3.fromRGB(20, 60, 90)
    s.Thickness = 3
    s.Parent = label
end

local function makeLabel(parent, text, size, position)
    local label = Instance.new("TextLabel")
    label.BackgroundTransparency = 1
    label.Size = size
    label.Position = position
    label.Text = text
    label.TextColor3 = COLORS.text
    label.Font = Enum.Font.FredokaOne
    label.TextSize = 15
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = parent

    addTextStroke(label)

    return label
end

local function makeButton(parent, text, size, position)
    local button = Instance.new("TextButton")
    button.Size = size
    button.Position = position
    button.BackgroundColor3 = COLORS.off
    button.Text = text
    button.TextColor3 = COLORS.text
    button.Font = Enum.Font.FredokaOne
    button.TextSize = 15
    button.BorderSizePixel = 0
    button.Parent = parent

    addCorner(button, 10)
    addStroke(button, COLORS.panelStroke, 3)

    return button
end

