        end
    end)

    local function driveBackIntoArena(car)
        local ch = car and car.PrimaryPart
        if not ch then return end

        local pos = ch.Position
        local offset = Vector3.new(
            pos.X - ZEUS_ARENA_CENTER.X,
            0,
            pos.Z - ZEUS_ARENA_CENTER.Z
        )

        if offset.Magnitude < 0.1 then
            driveTowardPosition(car, ZEUS_ARENA_CENTER, 0.7)
            return
        end

        local safeRadius = math.max(ZEUS_ARENA_RADIUS - 12, 1)

        if offset.Magnitude > safeRadius then
            local targetOffset = offset.Unit * safeRadius

            local target = Vector3.new(
                ZEUS_ARENA_CENTER.X + targetOffset.X,
                pos.Y,
                ZEUS_ARENA_CENTER.Z + targetOffset.Z
            )

            setBossStatus("RETURNING")
            driveTowardPosition(car, target, 0.75)
        end
    end

    local function runZeusBossDrive(car, dt)
        local zeus = getZeus()

        if not zeus then
            setBossStatus("WAITING FOR ZEUS")
            stopCar(car)
            return
        end

        local carPos = car.PrimaryPart.Position

        if not isInsideZeusArena(carPos) then
            driveBackIntoArena(car)
            return
        end

        if zeusAttackActive and tick() <= zeusAttackUntil then
            if tick() - lastDodge >= dodgeCooldown then
                lastDodge = tick()
            end

            setBossStatus("DODGE")
            driveTowardPosition(car, getSafeDodgePoint(car, zeus), 0.95)
            return
        end

        if tick() > zeusAttackUntil then
            zeusAttackActive = false
        end

        local fuel, fuelPos = getFuelPosition()

        if fuel and fuelPos then
            local distance = flatDistance(carPos, fuelPos)

            if distance <= FUEL_PICKUP_DISTANCE then
                setBossStatus("FUEL PICKUP")
                stopCar(car)
            else
                setBossStatus("FUEL")
                driveTowardPosition(car, fuelPos, 0.9)
            end

            return
        end

        -- Follow the CURRENT Zeus position instead of the old hard-coded
        -- first-spawn location. This keeps the circle centered on Zeus.
        local zeusPos = getModelPosition(zeus)
        if zeusPos then
            circleCenter = Vector3.new(zeusPos.X, circleCenter.Y, zeusPos.Z)
        end

        setBossStatus("CIRCLE")
        driveCircle(car, dt)
    end

    ------------------------------------------------------
    -- VEHICLE PHYSICS LOOP
    ------------------------------------------------------
    RunService.PostSimulation:Connect(function(dt)
        if not gui.Parent then return end

        if bossFarm then
            local car = getCar()

            if not car then
