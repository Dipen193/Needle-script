bossButton.MouseButton1Click:Connect(function()

    bossFarm =
        not bossFarm

    zeusAttackActive = false
    zeusAttackUntil = 0

    if bossFarm then

        setBossStatus("STARTING")
        attachZeusMonitor()

        local car = getCar()

        if car and car.PrimaryPart then

            local offset =
                car.PrimaryPart.Position -
                circleCenter

            if offset.X ~= 0
                or offset.Z ~= 0 then

                circleAngle =
                    math.atan2(
                        offset.Z,
                        offset.X
                    )
            end
        end
    else
        setBossStatus("OFF")
    end

    updateBossButton()
end)

