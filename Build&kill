--------------------------------------------------
-- GROUND RAYCAST
--------------------------------------------------

local function getGroundY(car, x, z)

    local size = car:GetExtentsSize()
    local currentPosition = car:GetPivot().Position

    local origin = Vector3.new(
        x,
        currentPosition.Y + 50,
        z
    )

    local direction = Vector3.new(0, -500, 0)

    local params = RaycastParams.new()

    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {car}

    local result = workspace:Raycast(
        origin,
        direction,
        params
    )

    if result then
        return result.Position.Y + size.Y / 2
    end

    return currentPosition.Y
end

--------------------------------------------------
-- STOP CAR
--------------------------------------------------

local function stopCarMovement()

    movementID += 1

    if moveTween then
        moveTween:Cancel()
        moveTween = nil
    end

    if moveConnection then
        moveConnection:Disconnect()
        moveConnection = nil
    end

    if xValue then
        xValue:Destroy()
        xValue = nil
    end

    moving = false
end

--------------------------------------------------
-- MOVE CAR
--------------------------------------------------

local function moveCar()

    if not car or not car.Parent then
        return
    end

    movementID += 1

    local thisMovement = movementID

    if moveTween then
        moveTween:Cancel()
        moveTween = nil
    end

    if moveConnection then
        moveConnection:Disconnect()
        moveConnection = nil
    end

    if xValue then
        xValue:Destroy()
        xValue = nil
    end

    local currentCF = car:GetPivot()
    local currentPos = currentCF.Position

    local startX = currentPos.X
    local distance = math.abs(targetX - startX)

    if distance < 0.1 then
        moving = false
        return
    end

    local rotation = currentCF - currentPos

    xValue = Instance.new("NumberValue")
    xValue.Value = startX

    local duration =
        distance / math.max(tweenSpeed, 0.1)

    moveTween = TweenService:Create(
        xValue,
        TweenInfo.new(
            duration,
            Enum.EasingStyle.Linear,
            Enum.EasingDirection.InOut
        ),
        {
            Value = targetX
        }
    )

    moveConnection = RunService.Heartbeat:Connect(function()

        if thisMovement ~= movementID then
            return
        end

        if not moving then
            return
        end

        if not car or not car.Parent then
            return
        end

        if not xValue then
            return
        end

        local x = xValue.Value
        local current = car:GetPivot()
        local z = current.Position.Z

        local groundY =
            getGroundY(car, x, z)

        car:PivotTo(
            CFrame.new(
                x,
                groundY,
                z
            ) * rotation
        )
    end)

    moveTween:Play()

    task.spawn(function()

        local tween = moveTween

        tween.Completed:Wait()

        if thisMovement ~= movementID then
            return
        end

        if moveConnection then
            moveConnection:Disconnect()
            moveConnection = nil
        end

        if xValue then
            xValue:Destroy()
            xValue = nil
        end

        moveTween = nil
        moving = false

        toggle.Text = "CAR: OFF"
        toggle.BackgroundColor3 =
            Color3.fromRGB(150, 45, 45)

        status.Text = "Reached target"
    end)
end

