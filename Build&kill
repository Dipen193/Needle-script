local function corner(obj, radius)

    local c =
        Instance.new("UICorner")

    c.CornerRadius =
        UDim.new(
            0,
            radius or 8
        )

    c.Parent = obj

    return c
end

local function stroke(
    obj,
    color,
    thickness
)

    local s =
        Instance.new("UIStroke")

    s.Color =
        color or Color3.fromRGB(
            70,
            70,
            75
        )

    s.Thickness =
        thickness or 2

    s.Parent = obj

    return s
end

