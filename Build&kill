toggle.MouseButton1Click:Connect(function()

    if not car or not car.Parent then
        status.Text = "Car not found"
        return
    end

    if not moving then

        local speed = tonumber(speedBox.Text)
        local x = tonumber(xBox.Text)

        if not speed or speed <= 0 then
            status.Text = "Invalid speed"
            return
        end

        if not x then
            status.Text = "Invalid X"
            return
        end

        tweenSpeed = speed
        targetX = x

        moving = true

        toggle.Text = "CAR: ON"
        toggle.BackgroundColor3 =
            Color3.fromRGB(45, 150, 70)

        status.Text = "Moving..."

        moveCar()

    else

        stopCarMovement()

        toggle.Text = "CAR: OFF"
        toggle.BackgroundColor3 =
            Color3.fromRGB(150, 45, 45)

        status.Text = "Car stopped"
    end
end)

--------------------------------------------------
-- START CIRCLE
--------------------------------------------------

local function startCircle()

    local character = player.Character
    local root =
        character and
        character:FindFirstChild("HumanoidRootPart")

    if not root then
        status.Text = "Character not found"
        return
    end

    circling = true
    circleAngle = 0

    circleButton.Text = "CIRCLE: ON"
    circleButton.BackgroundColor3 =
        Color3.fromRGB(45, 150, 70)

    status.Text =
        "Circling | R: " .. circleRadius

    circleConnection =
        RunService.Heartbeat:Connect(function(dt)

            if not circling then
                return
            end

            if not root or not root.Parent then
                return
            end

            circleAngle += dt * circleSpeed

            local offsetX =
                math.cos(circleAngle) *
                circleRadius

            local offsetZ =
                math.sin(circleAngle) *
                circleRadius

            local position =
                circleCenter +
                Vector3.new(
                    offsetX,
                    0,
                    offsetZ
                )

            root.CFrame =
                CFrame.lookAt(
                    position,
                    circleCenter
                )
        end)
end

--------------------------------------------------
-- STOP CIRCLE
--------------------------------------------------

local function stopCircle()

    circling = false

    if circleConnection then
        circleConnection:Disconnect()
        circleConnection = nil
    end

    circleButton.Text = "CIRCLE: OFF"
    circleButton.BackgroundColor3 =
        Color3.fromRGB(70, 70, 150)

    status.Text = "Circle stopped"
end

