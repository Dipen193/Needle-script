-- Exact prompt finder from working script

local gemPrompt = nil

local function findGemPrompt()

	-- Same first search
	local machine = workspace:FindFirstChild(
		"Arcade Machine",
		true
	)

	if machine then
		gemPrompt = machine:FindFirstChild(
			"PlayPrompt",
			true
		)
	end

	-- Same fallback search
	if not gemPrompt then

		for _, object in ipairs(workspace:GetDescendants()) do

			if object:IsA("ProximityPrompt")
				and object.Name == "PlayPrompt" then

				gemPrompt = object
				break

			end

		end

	end

	-- Same prompt settings
	if gemPrompt and gemPrompt.Parent then

		gemPrompt.HoldDuration = 0
		gemPrompt.MaxActivationDistance = math.huge
		gemPrompt.RequiresLineOfSight = false
		gemPrompt.ClickablePrompt = true

		return gemPrompt

	end

	return nil
end

