-- =========================================================
-- CLASS ROLL LOOP
-- =========================================================

task.spawn(function()

	while screenGui.Parent do

		task.wait(0.1)

		if running then

			local Event = ReplicatedStorage
				:WaitForChild("ClassSystem")
				:WaitForChild("RollClass")

			local success, result = pcall(function()
				return Event:InvokeServer()
			end)

			if success and type(result) == "table" then

				local rolledClass =
					result.className

				print(
					"Rolled:",
					rolledClass
				)

				if selected[rolledClass] then

					running = false

					rollButton.Text = "FOUND"

					rollButton.BackgroundColor3 =
						COLORS.selected

					print(
						"Found selected class:",
						rolledClass
					)

				end

			end

		end

	end

end)

-- =========================================================
-- ROLL ON/OFF
-- =========================================================

rollButton.MouseButton1Click:Connect(function()

	if running then

		running = false

		rollButton.Text = "OFF"
		rollButton.BackgroundColor3 =
			COLORS.off

		return

	end

	local count = 0

	for _ in pairs(selected) do
		count += 1
	end

	if count == 0 then

		rollButton.Text = "SELECT"

		rollButton.BackgroundColor3 =
			COLORS.clickBtn

		task.delay(1, function()

			if not running then

				rollButton.Text = "OFF"

				rollButton.BackgroundColor3 =
					COLORS.off

			end

		end)

		return

	end

	running = true

	rollButton.Text = "ON"

	rollButton.BackgroundColor3 =
		COLORS.on

end)

