local function getNeedleCandidates()
    local candidates = {}

    if not NeedleFolder then
        return candidates
    end

    local function addCandidate(obj)
        if not obj or obj == NeedleFolder then
            return
        end

        local name = obj.Name:lower()

        if name:find("needle", 1, true) then
            if obj:IsA("BasePart")
                or obj:IsA("Model") then

                table.insert(candidates, obj)
                return
            end

            local part =
                obj:FindFirstChildWhichIsA(
                    "BasePart",
                    true
                )

            if part then
                table.insert(candidates, obj)
                return
            end
        end

        if (
            obj:IsA("BasePart")
            or obj:IsA("Model")
        )
            and obj:FindFirstChildWhichIsA(
                "ProximityPrompt",
                true
            ) then

            table.insert(candidates, obj)
        end
    end

    for _, obj in ipairs(
        NeedleFolder:GetDescendants()
    ) do
        addCandidate(obj)
    end

    for _, obj in ipairs(
        NeedleFolder:GetChildren()
    ) do
        addCandidate(obj)
    end

    local unique = {}
    local result = {}

    for _, obj in ipairs(candidates) do
        if not unique[obj] then
            unique[obj] = true
            table.insert(result, obj)
        end
    end

    return result
end

local function getNeedle()
    local mainFolder =
        workspace:FindFirstChild("Main")

    local n =
        mainFolder
        and mainFolder:FindFirstChild("Needle")

    if n then
        return n
    end

    local candidates = getNeedleCandidates()

    for _, candidate in ipairs(candidates) do
        if candidate.Parent then
            return candidate
        end
    end

    return nil
end

local function getNeedlePosition(needle)
    if not needle then
        return nil
    end

    if needle:IsA("BasePart") then
        return needle.Position
    end

    if needle:IsA("Model") then
        if needle.PrimaryPart then
            return needle.PrimaryPart.Position
        end

        local part =
            needle:FindFirstChildWhichIsA(
                "BasePart",
                true
            )

        if part then
            return part.Position
        end
    end

    return nil
end

local function equipTool(tool)
    refreshNeedleCharacter()

    if not needleHumanoid or not tool then
        return false
    end

    pcall(function()
        needleHumanoid:EquipTool(tool)
    end)

    task.wait(0.12)

    return tool.Parent == needleCharacter
end

local function getTools()
    local char = player.Character
    local backpack =
        player:FindFirstChildOfClass("Backpack")

    local found = {
        hay = {},
        vacuum = {},
        pitchfork = {},
        tnt = {}
    }

    local function scan(container)
        if not container then
            return
        end

        for _, obj in ipairs(
            container:GetChildren()
        ) do
            if obj:IsA("Tool") then
                local n = obj.Name:lower()

                if n:find("tnt") then
                    table.insert(found.tnt, obj)

                elseif n:find("vacuum") then
                    table.insert(found.vacuum, obj)

                elseif n:find("pitchfork")
                    or n:find("fork") then

                    table.insert(
                        found.pitchfork,
                        obj
                    )

                elseif n:find("hay")
                    or n:find("pick") then

                    table.insert(
                        found.hay,
                        obj
                    )
                end
            end
        end
    end

    scan(backpack)
    scan(char)

    return found
end

local function activateTool(
    tool,
    count,
    delayTime
)
    if not tool then
        return
    end

    count = count or 1
    delayTime = delayTime or 0.12

    refreshNeedleCharacter()

    if not needleHumanoid then
        return
