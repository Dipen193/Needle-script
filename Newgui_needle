local autoSellHay = false

local function readFirstNumber(value)
    if value == nil then
        return nil
    end

    local text = tostring(value):gsub(",", "")

    local numberText =
        text:match("%-?%d+%.?%d*")

    return numberText
        and tonumber(numberText)
        or nil
end

local function readCapacityPair(value)
    if value == nil then
        return nil, nil
    end

    local text = tostring(value):gsub(",", "")

    local a, b =
        text:match("(%d+)%s*/%s*(%d+)")

    if a and b then
        return tonumber(a), tonumber(b)
    end

    return nil, nil
end

sellAndReturnHay = function()
    if isSellingHay then
        return
    end

    isSellingHay = true
    NeedleX.lastSell = os.clock()

    if vacuumStarted and VacuumAction then
        pcall(function()
            VacuumAction:FireServer("Stop")
        end)

        vacuumStarted = false
    end

    pcall(function()
        local char =
            player.Character
            or player.CharacterAdded:Wait()

        local root =
            char:WaitForChild(
                "HumanoidRootPart"
            )

        local sellPart =
            workspace:WaitForChild(
                "SellModel"
            ):WaitForChild("SellPart")

        local sellEvent =
            ReplicatedStorage
            :WaitForChild("NeedleHaystack")
            :WaitForChild("SellHay")

        local originalCFrame = root.CFrame

        root.CFrame =
            sellPart.CFrame
            + Vector3.new(0, 3, 0)

        task.wait(0.25)

        sellEvent:FireServer()

        task.wait(0.45)

        if root and root.Parent then
            root.CFrame = originalCFrame
        end

        task.wait(0.15)

        if autoCollectHay
            and restartHayVacuum then

            restartHayVacuum()
        end
    end)

    isSellingHay = false
end

task.spawn(function()
    while gui and gui.Parent do
        if autoSellHay
            and not isSellingHay
            and not needleBusy
            and not (needleAuto and getNeedle()) then

            pcall(function()
                local playerGui =
                    player:FindFirstChild(
                        "PlayerGui"
                    )

                local hud =
                    playerGui
                    and playerGui:FindFirstChild(
                        "HUD"
                    )

                local function findDescendant(
                    parent,
                    name
                )
                    if not parent then
                        return nil
                    end

                    local direct =
                        parent:FindFirstChild(name)

                    if direct then
                        return direct
                    end

                    for _, obj in ipairs(
                        parent:GetDescendants()
                    ) do
                        if obj.Name == name then
                            return obj
                        end
                    end

                    return nil
                end

                local capacityUI =
                    findDescendant(
                        hud,
                        "Capacity"
                    )

                local currentAmount =
                    findDescendant(
                        capacityUI or hud,
                        "CurrentAmount"
                    )

                local totalCapacity =
                    findDescendant(
                        capacityUI or hud,
                        "TotalCapacity"
                    )

                local function textValue(obj)
                    if not obj then
                        return nil
                    end

                    if obj:IsA("TextLabel")
                        or obj:IsA("TextButton")
                        or obj:IsA("TextBox") then

                        return obj.Text
                    end

                    local ok, value =
                        pcall(function()
                            return obj.Value
                        end)

                    if ok and value ~= nil then
                        return tostring(value)
                    end

                    return nil
                end

                local currentText =
                    textValue(currentAmount)

                local maxText =
                    textValue(totalCapacity)

                local current =
                    readFirstNumber(currentText)

                local maximum =
                    readFirstNumber(maxText)

                local pairMax, pairCurrent =
                    readCapacityPair(currentText)

                if pairMax and pairCurrent then
                    maximum = pairMax
                    current = pairCurrent
                end

                local pairMax2, pairCurrent2 =
                    readCapacityPair(maxText)

                if pairMax2 and pairCurrent2 then
                    maximum = pairMax2
                    current = pairCurrent2
                end

                if not maximum and hud then
                    for _, obj in ipairs(
                        hud:GetDescendants()
                    ) do
                        if obj:IsA("TextLabel")
                            or obj:IsA("TextButton") then

                            local txt =
                                tostring(
                                    obj.Text or ""
                                ):gsub(",", "")

                            local a, b =
                                txt:match(
                                    "(%d+)%s*/%s*(%d+)"
                                )

                            if a and b then
                                maximum = tonumber(a)
                                current = tonumber(b)
                                break
                            end
                        end
                    end
                end

                if current
                    and maximum
                    and maximum > 0
                    and current >= maximum then

                    sellAndReturnHay()
                else
                    -- Infinite capacity (shows "inf", a huge number, or no
                    -- readable maximum): the bag never fills, so sell on
                    -- a timer instead.
                    local mt = tostring(maxText or ""):lower()
                    local ct = tostring(currentText or ""):lower()

                    local infinite =
                        mt:find("inf", 1, true)
                        or mt:find("\226\136\158", 1, true)
                        or ct:find("inf", 1, true)
                        or ct:find("\226\136\158", 1, true)
                        or not maximum
                        or maximum >= 1e9

                    if infinite
                        and os.clock() - NeedleX.lastSell
                            >= NeedleX.sellEvery then

                        sellAndReturnHay()
                    end
                end
            end)
        end

        task.wait(0.15)
    end
end)

