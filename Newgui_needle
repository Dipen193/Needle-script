        local sp, onScreen = cam:WorldToViewportPoint(pos)
        local vp = cam.ViewportSize

        if onScreen
            and sp.Z > 0
            and sp.X >= 0 and sp.X <= vp.X
            and sp.Y >= 0 and sp.Y <= vp.Y then

