                local statsUI =
                    player:FindFirstChild(
                        "PlayerGui"
                    )
                    and player.PlayerGui:FindFirstChild(
                        "PlayerStatsUI"
                    )

                local gemLabel =
                    statsUI
                    and statsUI:FindFirstChild(
                        "Frame"
                    )
                    and statsUI.Frame:FindFirstChild(
                        "GemFrame"
                    )
                    and statsUI.Frame.GemFrame:FindFirstChild(
                        "GemLabel"
                    )

                return gemLabel
                    and gemLabel.Text
            end)

        if ok and textValue then
            gemsDisplay.Text =
                "Gems: "
                .. tostring(textValue)
        end

        task.wait(0.25)
    end
end)

