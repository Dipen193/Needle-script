local function collectGemObject(gem)
    if not autoPickGems or not gem or not gem.Parent then return end
    local id = tonumber(gem.Name:match("^Gem_(%d+)$"))
    if not id or collectedGemIds[id] then return end
    collectedGemIds[id] = true
    pcall(function() CollectGem:FireServer(id) end)
    task.delay(1, function()
        if not gem or not gem.Parent then collectedGemIds[id] = nil end
    end) 
end

local function scanExistingGems()
    for _, gem in ipairs(GemsClient:GetChildren()) do
        if gem.Name:match("^Gem%d+$") then
