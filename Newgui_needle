local function readFirstNumber(value)
    if value == nil then
        return nil
    end

    local text = tostring(value):gsub(",", "")

    local numberText =
        text:match("%-?%d+%.?%d*")

    return numberText
        and tonumber(numberText)
        or nil
end

local function readCapacityPair(value)
    if value == nil then
        return nil, nil
    end

    local text = tostring(value):gsub(",", "")

    local a, b =
        text:match("(%d+)%s*/%s*(%d+)")

    if a and b then
        return tonumber(a), tonumber(b)
    end

    return nil, nil
end

local function sellAndReturnHay()
    if isSellingHay then
        return
    end

    isSellingHay = true

    if vacuumStarted and VacuumAction then
        pcall(function()
            VacuumAction:FireServer("Stop")
