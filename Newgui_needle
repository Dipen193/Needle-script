local function refreshHayTools()
    NH = ReplicatedStorage:FindFirstChild("NeedleHaystack")
    TntAction = NH and NH:FindFirstChild("TntAction")
    HeldToolState = NH and NH:FindFirstChild("HeldToolState")
    PickHay = NH and NH:FindFirstChild("PickHay")
    PitchforkDig = NH and NH:FindFirstChild("PitchforkDig")
    VacuumAction = NH and NH:FindFirstChild("VacuumAction")
    hayFolder = workspace:FindFirstChild("HaystackClient")
    return NH, hayFolder
end

local function resetTntState()
    -- If Auto TNT was enabled before the player owned TNT, the previous
    -- failed attempt can leave the server's held-tool state out of sync.
    if HeldToolState then
        pcall(function()
            HeldToolState:FireServer()
        end)
    end
end

local function getHayPosition(hay)
    if hay:IsA("BasePart") then return hay.Position end
    if hay:IsA("Model") then
        local part = hay.PrimaryPart or hay:FindFirstChildWhichIsA("BasePart")
        if part then return part.Position end
    end
    return nil
end

local function getHighestHay()
    refreshHayTools()
    if not hayFolder then return nil end
    if not TntAction or not HeldToolState then return nil end
    local camera = workspace.CurrentCamera
    local origin = camera.CFrame.Position
    local look = camera.CFrame.LookVector
    local highest = nil
    local highestY = -math.huge

    for _, hay in ipairs(hayFolder:GetChildren()) do
        if hay.Name == "HayPiece" then
            local pos = getHayPosition(hay)
            if pos then
                local offset = pos - origin
                local distance = offset.Magnitude
                if distance <= 30 and distance > 0 then
                    local dot = math.clamp(look:Dot(offset.Unit), -1, 1)
                    local angle = math.deg(math.acos(dot))
                    if angle <= 45 and pos.Y > highestY then
                        highestY = pos.Y
                        highest = { position = pos, distance = distance }
                    end
                end
            end
        end
    end
    return highest
end

local function throwAtHighest()
    refreshHayTools()
    if not TntAction or not HeldToolState then return false end

    local character = player.Character
    if not character then return false end
    local root = character:FindFirstChild("HumanoidRootPart")
    if not root then return false end

    local target = getHighestHay()
    if not target then return false end

    -- Reset first so buying TNT while Auto TNT is already ON does not require
    -- toggling the option off and back on.
    resetTntState()

    local startPosition = root.Position + Vector3.new(0, 3, 0)
    local directionVector = target.position - startPosition
    if directionVector.Magnitude <= 0 then return false end

    local direction = directionVector.Unit
    local throwCFrame = CFrame.lookAt(startPosition, startPosition + direction)
    local velocity = direction * 65

    pcall(function()
        TntAction:FireServer("light")
    end)
    task.wait(0.48)

    pcall(function()
        HeldToolState:FireServer("Tnt", "lighting")
    end)
    task.wait(0.1)

    pcall(function()
        HeldToolState:FireServer("Tnt", "ready")
    end)
    task.wait(0.1)

    pcall(function()
        HeldToolState:FireServer("Tnt", "charging")
    end)
    task.wait(0.2)

    pcall(function()
        TntAction:FireServer("throw", throwCFrame, velocity)
    end)
    task.wait(0.1)

    -- Always clear the held state after an attempt. This is important when
    -- the first attempts happened before TNT was purchased.
    resetTntState()
    return true
end

