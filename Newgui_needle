local autoPickGems = false
local gemCollectConnection = nil
local collectedGemIds = {}

local GemsClient = nil
local CollectGem = nil

local function getGemObjects()
    GemsClient =
        workspace:FindFirstChild("GemsClient")

    local nh =
        ReplicatedStorage:FindFirstChild(
            "NeedleHaystack"
        )

    CollectGem =
        nh and nh:FindFirstChild("CollectGem")

    return GemsClient, CollectGem
end

local function collectGemObject(gem)
    if not autoPickGems
        or not gem
        or not gem.Parent then

        return
    end

    local id =
        tonumber(
            gem.Name:match("^Gem_(%d+)$")
        )

    if not id
        or collectedGemIds[id] then

        return
    end

    collectedGemIds[id] = true

    pcall(function()
        CollectGem:FireServer(id)
    end)

    task.delay(1, function()
        if not gem or not gem.Parent then
            collectedGemIds[id] = nil
        end
    end)
end

local function scanExistingGems()
    for _, gem in ipairs(
        GemsClient:GetChildren()
    ) do

        if gem.Name:match("^Gem%d+$") then
            collectGemObject(gem)
        end
    end
end

local function startAutoPickGems()
    local gemFolder, collectEvent =
        getGemObjects()

    if not gemFolder or not collectEvent then
        return
    end

    GemsClient = gemFolder
    CollectGem = collectEvent

    if gemCollectConnection then
        gemCollectConnection:Disconnect()
        gemCollectConnection = nil
    end

    table.clear(collectedGemIds)

    scanExistingGems()

    gemCollectConnection =
        GemsClient.ChildAdded:Connect(function(gem)
            if not autoPickGems then
                return
            end

            task.wait()

            collectGemObject(gem)
        end)
end

local function stopAutoPickGems()
    if gemCollectConnection then
        gemCollectConnection:Disconnect()
        gemCollectConnection = nil
    end

    table.clear(collectedGemIds)
end

