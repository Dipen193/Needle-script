rollClass.MouseButton1Click:Connect(function()
	if classRolling then
		classRolling = false
		rollClass.Text = "ROLL CLASSES"
		rollClass.BackgroundColor3 = OFF
		return
	end
	local count = 0
	for _ in pairs(selectedClasses) do count += 1 end
	if count == 0 then
		rollClass.Text = "SELECT FIRST"
		rollClass.BackgroundColor3 = RED
		task.delay(0.8, function()
			if not classRolling then
				rollClass.Text = "ROLL CLASSES"
				rollClass.BackgroundColor3 = OFF
			end
		end)
		return
	end
	classRolling = true
	rollClass.Text = "ROLLING..."
	rollClass.BackgroundColor3 = RED
end)

task.spawn(function()
	local Event = ReplicatedStorage:WaitForChild("ClassSystem"):WaitForChild("RollClass")
	while gui.Parent do
		task.wait(0.1)
		if classRolling then
			local ok, result = pcall(function() return Event:InvokeServer() end)
			if ok and type(result) == "table" and selectedClasses[result.className] then
				classRolling = false
				rollClass.Text = "✓ FOUND: " .. tostring(result.className)
				rollClass.BackgroundColor3 = RED
			end
		end
	end
end)

