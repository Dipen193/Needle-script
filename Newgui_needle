    player.Character or player.CharacterAdded:Wait()
)


--========================================================
-- NEEDLE
--========================================================

local function getNeedle()

    local mainFolder =
        workspace:FindFirstChild("Main")

    return mainFolder
        and mainFolder:FindFirstChild("Needle")
end


local function getNeedlePart(n)

    if not n then
        return nil
    end

    if n:IsA("BasePart") then
        return n
    end

    if n.PrimaryPart then
        return n.PrimaryPart
    end

    return n:FindFirstChildWhichIsA(
        "BasePart",
        true
    )
end


local function stopNeedleFly()

    needleFlying = false

    if needleFlyConnection then
        needleFlyConnection:Disconnect()
        needleFlyConnection = nil
    end

    if needleRoot then

        local bv =
            needleRoot:FindFirstChild(
                "NeedleFlyVelocity"
            )

        if bv then
            bv:Destroy()
        end

        local bg =
            needleRoot:FindFirstChild(
                "NeedleFlyGyro"
            )

        if bg then
            bg:Destroy()
        end
    end
end


local function forcePlayerCamera()

    local cam =
        workspace.CurrentCamera

    if cam and needleHumanoid then

        cam.CameraType =
            Enum.CameraType.Custom

        cam.CameraSubject =
            needleHumanoid
    end
end


local function stopNeedleCamera()

    needleCameraFocused = false

    if needleCameraConnection then
        needleCameraConnection:Disconnect()
        needleCameraConnection = nil
    end

    forcePlayerCamera()
end


local function startNeedleFly()

    if not needleRoot then
        return
    end

    stopNeedleFly()

    needleFlying = true

    local bv =
        Instance.new("BodyVelocity")

    bv.Name = "NeedleFlyVelocity"
    bv.MaxForce =
        Vector3.new(
            1e9,
            1e9,
            1e9
        )

    bv.Parent = needleRoot


    local bg =
        Instance.new("BodyGyro")

    bg.Name = "NeedleFlyGyro"

    bg.MaxTorque =
        Vector3.new(
            1e9,
            1e9,
            1e9
        )

    bg.Parent = needleRoot


    if needleHumanoid then
        needleHumanoid.PlatformStand = true
    end


    needleFlyConnection =
        RunService.RenderStepped:Connect(function()

            if
                not needleFlying
                or not needleRoot
                or not needleRoot.Parent
            then
                return
            end

            local cam =
                workspace.CurrentCamera

            if not cam then
                return
            end

            local dir =
                Vector3.zero

            if UserInputService:IsKeyDown(
                Enum.KeyCode.W
            ) then
                dir += cam.CFrame.LookVector
            end

            if UserInputService:IsKeyDown(
                Enum.KeyCode.S
            ) then
                dir -= cam.CFrame.LookVector
            end

            if UserInputService:IsKeyDown(
                Enum.KeyCode.A
            ) then
                dir -= cam.CFrame.RightVector
            end

            if UserInputService:IsKeyDown(
                Enum.KeyCode.D
            ) then
                dir += cam.CFrame.RightVector
            end

            if UserInputService:IsKeyDown(
                Enum.KeyCode.Space
            ) then
                dir += cam.CFrame.UpVector
            end

            if dir.Magnitude > 0 then

                dir = dir.Unit

                bg.CFrame =
                    needleRoot.CFrame:Lerp(
                        CFrame.lookAt(
                            needleRoot.Position,
                            needleRoot.Position + dir
                        ),
                        0.3
                    )
            end

            bv.Velocity =
                dir * needleSpeed
        end)
end


local function focusNeedleCamera()

    if needleCameraConnection then
        needleCameraConnection:Disconnect()
    end

    local cam =
        workspace.CurrentCamera

    if not cam then
        return
    end

    needleCameraFocused = true

    cam.CameraType =
        Enum.CameraType.Scriptable

    needleCameraConnection =
        RunService.RenderStepped:Connect(function()

            if not needleCameraFocused then
                return
            end

            local part =
                getNeedlePart(
                    getNeedle()
                )

            if not part or not needleRoot then
                return
            end

            local camNow =
                workspace.CurrentCamera

            if camNow then

                camNow.CFrame =
                    CFrame.lookAt(
                        needleRoot.Position
                            + Vector3.new(0, 2, 5),
                        part.Position
                    )
            end
        end)
end


local function pressNeedleE()

    VirtualInputManager:SendKeyEvent(
        true,
        Enum.KeyCode.E,
        false,
        nil
    )

    task.wait(0.05)

    VirtualInputManager:SendKeyEvent(
        false,
        Enum.KeyCode.E,
        false,
        nil
    )
end


local function autoPickNeedleOnce()

    refreshNeedleCharacter(
        player.Character
    )

    if not needleRoot then
        return
    end

    local part =
        getNeedlePart(
            getNeedle()
        )

    if not part then
        return
    end

    local pos =
        part.Position
        - part.CFrame.LookVector * 3

    needleRoot.CFrame =
        CFrame.lookAt(
            Vector3.new(
                pos.X,
                part.Position.Y,
                pos.Z
            ),
            part.Position
        )

    focusNeedleCamera()

    for _ = 1, needleInteractions do

        if not needleAuto then
            break
        end

        pressNeedleE()

        task.wait(0.1)
    end

    stopNeedleCamera()

    if needleAuto then
        startNeedleFly()
    end
end


local function startAutoNeedleLoop()

    task.spawn(function()

        while
            needleAuto
            and gui.Parent
        do

            pcall(
                autoPickNeedleOnce
            )

            task.wait(0.5)
        end
    end)
end


local function stopAutoNeedle()

    stopNeedleFly()
    stopNeedleCamera()

    if needleHumanoid then
        needleHumanoid.PlatformStand = false
    end
end


--========================================================
-- AUTO COLLECT HAY
-- PickHay + PitchforkDig + VacuumAction
--========================================================

local autoCollectHay = false

local HaystackClient =
    workspace:WaitForChild(
        "HaystackClient"
    )

local PickHay =
    ReplicatedStorage
        :WaitForChild("NeedleHaystack")
        :WaitForChild("PickHay")

local PitchforkDig =
    ReplicatedStorage
        :WaitForChild("NeedleHaystack")
        :WaitForChild("PitchforkDig")

local VacuumAction =
    ReplicatedStorage
        :WaitForChild("NeedleHaystack")
        :WaitForChild("VacuumAction")


local function getHayPosition(hay)

    if hay:IsA("BasePart") then
        return hay.Position
    end

    if hay:IsA("Model") then

        local part =
            hay.PrimaryPart
            or hay:FindFirstChildWhichIsA(
                "BasePart"
            )

        if part then
            return part.Position
        end
    end

    return nil
end


--========================================================
-- PICK HAY
--========================================================

local function collectNearbyHay()

    local cam =
        workspace.CurrentCamera

    if not cam then
        return
    end

    local origin =
        cam.CFrame.Position

    local look =
        cam.CFrame.LookVector

    local ids = {}

    local candidates = {}

    for _, hay in ipairs(
        HaystackClient:GetChildren()
    ) do

        if hay.Name == "HayPiece" then

            local pos =
                getHayPosition(hay)

            if pos then

                local offset =
                    pos - origin

                local distance =
                    offset.Magnitude

                if
                    distance <= 20
                    and distance > 0
                then

                    local dot =
                        math.clamp(
                            look:Dot(
                                offset.Unit
                            ),
                            -1,
                            1
                        )

                    local angle =
                        math.deg(
                            math.acos(dot)
                        )

                    if angle <= 35 then

                        local id =
                            tonumber(
                                hay:GetAttribute(
                                    "HayId"
                                )
                            )

                        if id then

                            table.insert(
                                candidates,
                                {
                                    id = id,
                                    distance = distance
                                }
                            )
                        end
                    end
                end
            end
        end
    end


    table.sort(
        candidates,
        function(a, b)
            return a.distance < b.distance
        end
    )


    -- Practical server/client limit
    for i = 1, math.min(12, #candidates) do

        table.insert(
            ids,
            candidates[i].id
        )
    end


    if #ids > 0 then

        pcall(function()

            PickHay:FireServer(
                ids[1],
                ids
            )

        end)
    end
end


--========================================================
-- PITCHFORK
--========================================================

local function getClosestHayId()

    local char =
        player.Character

    local root =
        char
        and char:FindFirstChild(
            "HumanoidRootPart"
        )

    if not root then
        return nil
    end

    local bestId
    local bestDistance =
        math.huge

    for _, hay in ipairs(
        HaystackClient:GetChildren()
    ) do

        if hay.Name == "HayPiece" then

            local pos =
                getHayPosition(hay)

            if pos then

                local distance =
                    (
                        pos - root.Position
                    ).Magnitude

                if distance < bestDistance
                and distance <= 4.2 then

                    local id =
                        tonumber(
                            hay:GetAttribute(
                                "HayId"
                            )
                        )

                    if id then
                        bestDistance = distance
                        bestId = id
                    end
                end
            end
        end
    end

    return bestId
end


local function usePitchfork()

    local id =
        getClosestHayId()

    if id then

        pcall(function()

            PitchforkDig:FireServer(
                id
            )

        end)
    end
end


--========================================================
-- VACUUM
--========================================================

local function vacuumHay()

    local char =
        player.Character

    local root =
        char
        and char:FindFirstChild(
            "HumanoidRootPart"
        )

    if not root then
        return
    end

    local firstHay
    local ids = {}

    local closestDistance =
        math.huge


    for _, hay in ipairs(
        HaystackClient:GetChildren()
    ) do

        if hay.Name == "HayPiece" then

            local pos =
                getHayPosition(hay)

            if pos then

                local distance =
                    (
                        pos - root.Position
                    ).Magnitude

                if distance < closestDistance then

                    closestDistance =
                        distance

                    firstHay = pos
                end
            end
        end
    end


    if not firstHay then
        return
    end


    for _, hay in ipairs(
        HaystackClient:GetChildren()
    ) do

        if hay.Name == "HayPiece" then

            local pos =
                getHayPosition(hay)

            if pos then

                if
                    (
                        pos - root.Position
                    ).Magnitude <= 20
                then

                    local id =
                        tonumber(
                            hay:GetAttribute(
                                "HayId"
                            )
                        )

                    if id then

                        table.insert(
                            ids,
                            id
                        )

                        if #ids >= 8 then
                            break
                        end
                    end
                end
            end
        end
    end


    if #ids > 0 then

        pcall(function()

            VacuumAction:FireServer(
                "Start"
            )

            task.wait(0.05)

            VacuumAction:FireServer(
                "Tick",
                root.Position,
                firstHay,
                ids
            )

            task.wait(0.05)

            VacuumAction:FireServer(
                "Stop"
            )

        end)
    end
end


local function autoCollectHayLoop()

    task.spawn(function()

        while
            autoCollectHay
            and gui.Parent
        do

            pcall(collectNearbyHay)

            pcall(usePitchfork)

            pcall(vacuumHay)

            task.wait(0.15)
        end
    end)
end


--========================================================
-- AUTO TNT
-- Proven working timing
--========================================================

local autoTNT = false
local tntBusy = false

local TntAction =
    ReplicatedStorage
        :WaitForChild("NeedleHaystack")
        :WaitForChild("TntAction")

local HeldToolState =
    ReplicatedStorage
        :WaitForChild("NeedleHaystack")
        :WaitForChild("HeldToolState")


local TNT_THROW_SPEED = 65
local TNT_COOLDOWN = 20
local TNT_MAX_DISTANCE = 30
local TNT_MAX_ANGLE = 45


local function getHighestHayForTNT()

    local cam =
        workspace.CurrentCamera

    if not cam then
        return nil
    end

    local origin =
        cam.CFrame.Position

    local look =
        cam.CFrame.LookVector

    local highest
    local highestY =
        -math.huge


    for _, hay in ipairs(
        HaystackClient:GetChildren()
    ) do

        if hay.Name == "HayPiece" then

            local pos =
                getHayPosition(hay)

            if pos then

                local offset =
                    pos - origin

                local distance =
                    offset.Magnitude

                if
                    distance <= TNT_MAX_DISTANCE
                    and distance > 0
                then

                    local dot =
                        math.clamp(
                            look:Dot(
                                offset.Unit
                            ),
                            -1,
                            1
                        )

                    local angle =
                        math.deg(
                            math.acos(dot)
                        )

                    if
                        angle <= TNT_MAX_ANGLE
                        and pos.Y > highestY
                    then

                        highestY = pos.Y

                        highest = {
                            position = pos,
                            distance = distance
                        }
                    end
                end
            end
        end
    end

    return highest
end


local function throwAutoTNT()

    if tntBusy then
        return
    end

    local character =
        player.Character

    if not character then
        return
    end

    local root =
        character:FindFirstChild(
            "HumanoidRootPart"
        )

    if not root then
        return
    end

    local target =
        getHighestHayForTNT()

    if not target then
        return
    end

    tntBusy = true


    local startPosition =
        root.Position
        + Vector3.new(0, 3, 0)

    local direction =
        (
            target.position
            - startPosition
        ).Unit


    local throwCFrame =
        CFrame.lookAt(
            startPosition,
            startPosition + direction
        )


    local velocity =
        direction * TNT_THROW_SPEED


    pcall(function()

        -- Proven working sequence

        TntAction:FireServer(
            "light"
        )

        task.wait(0.48)

        HeldToolState:FireServer(
            "Tnt",
            "lighting"
        )

        task.wait(0.1)

        HeldToolState:FireServer(
            "Tnt",
            "ready"
        )

        task.wait(0.1)

        HeldToolState:FireServer(
            "Tnt",
            "charging"
        )

        task.wait(0.2)

        TntAction:FireServer(
            "throw",
            throwCFrame,
            velocity
        )

        task.wait(0.1)

        HeldToolState:FireServer()

    end)


    task.wait(TNT_COOLDOWN)

    tntBusy = false
end


local function autoTNTLoop()

    task.spawn(function()

        while
            autoTNT
            and gui.Parent
        do

            pcall(
                throwAutoTNT
            )

            task.wait(0.2)
        end
    end)
end


--========================================================
-- AUTO SELL
-- Full OR OVER capacity
--========================================================

local autoSellHay = false
local isSellingHay = false

-- Small delays
local SELL_TRAVEL_DELAY = 0.35
local SELL_EVENT_DELAY = 0.15
local RETURN_DELAY = 0.35


local function getHayCapacity()

    local ok, current, maximum =
        pcall(function()

            local hud =
                player.PlayerGui
                    :WaitForChild("HUD")
                    :WaitForChild("BottomLeft")

            local capacity =
                hud:WaitForChild(
                    "Capacity"
                )

            local currentAmount =
                capacity:WaitForChild(
                    "CurrentAmount"
                )

            local totalCapacity =
                capacity
                    :WaitForChild(
                        "BackgroundHaybale"
                    )
                    :WaitForChild(
                        "TotalCapacity"
                    )

            return
                tonumber(
                    currentAmount.Text
                ),
                tonumber(
                    totalCapacity.Text
                )
        end)

    if ok then
        return current, maximum
    end

    return nil, nil
end


local function sellAndReturnHay()

    if isSellingHay then
        return
    end

    isSellingHay = true


    pcall(function()

        local char =
            player.Character
            or player.CharacterAdded:Wait()

        local root =
            char:WaitForChild(
                "HumanoidRootPart"
            )

        local sellPart =
            workspace
                :WaitForChild(
                    "SellModel"
                )
                :WaitForChild(
                    "SellPart"
                )

        local sellEvent =
            ReplicatedStorage
                :WaitForChild(
                    "NeedleHaystack"
                )
                :WaitForChild(
                    "SellHay"
                )


        -- Save exact original position
        local originalCFrame =
            root.CFrame


        -- Go to sell
        root.CFrame =
            sellPart.CFrame
            + Vector3.new(0, 3, 0)


        -- Small delay after teleport
        task.wait(
            SELL_TRAVEL_DELAY
        )


        -- Sell
        sellEvent:FireServer()


        -- Give server time to process
        task.wait(
            SELL_EVENT_DELAY
        )


        -- Small delay before returning
        task.wait(
            RETURN_DELAY
        )


        -- Return
        if root and root.Parent then
            root.CFrame =
                originalCFrame
        end

    end)


    isSellingHay = false
end


task.spawn(function()

    while
        gui
        and gui.Parent
    do

        if autoSellHay
        and not isSellingHay
        then

            local current, maximum =
                getHayCapacity()


            -- Sell when:
            -- 1. exactly full
            -- 2. already over capacity

            if
                current
                and maximum
                and current >= maximum
            then

                task.spawn(
                    sellAndReturnHay
                )
            end
        end

        task.wait(0.15)
    end
end)


