-- 7. RANDOM TP TO HAY
-- ==========================================================
local autoTPHay = false

-- Maximum distance from the player to consider a HayPiece
local tpHayDistance = 50

-- Height above the selected HayPiece
local tpHayYLevel = 4

-- Remember the previous target so we don't immediately
-- teleport to the exact same HayPiece repeatedly.
local lastTPHayTarget = nil

local function getRandomHayTarget()
    local hayFolder =
        workspace:FindFirstChild(
            "HaystackClient"
        )

    if not hayFolder then
        return nil
    end

    local char = player.Character

    local root =
        char
        and char:FindFirstChild(
            "HumanoidRootPart"
        )

    if not root then
        return nil
    end

    local candidates = {}

    for _, hay in ipairs(
        hayFolder:GetChildren()
    ) do

        if hay.Name == "HayPiece" then
            local pos = nil

            if hay:IsA("BasePart") then
                pos = hay.Position

            elseif hay:IsA("Model") then
                local part =
                    hay.PrimaryPart
                    or hay:FindFirstChildWhichIsA(
                        "BasePart"
                    )

                if part then
                    pos = part.Position
                end
            end

            if pos then
                local distance =
                    (pos - root.Position).Magnitude

                if distance <= tpHayDistance then
                    table.insert(
                        candidates,
                        {
                            object = hay,
                            position = pos,
                            distance = distance
                        }
                    )
                end
            end
        end
    end

    if #candidates == 0 then
        return nil
    end

    -- Remove the previous target when possible.
    if #candidates > 1
        and lastTPHayTarget then

        local filtered = {}

        for _, candidate in ipairs(
            candidates
        ) do
            if candidate.object
                ~= lastTPHayTarget then

                table.insert(
                    filtered,
                    candidate
                )
            end
        end

        if #filtered > 0 then
            candidates = filtered
        end
    end

    local chosen =
        candidates[
            math.random(
                1,
                #candidates
            )
        ]

    lastTPHayTarget = chosen.object

    return chosen
end

