-- ---------- ORDERED BUY PLAN (wait for money, never skip ahead) ----------
-- Same idea as "Hand Grab x2": check money -> buy if we can, otherwise
-- wait until money increases, then continue with the next step.
autoWinBg.plan = {
    { "up",   "Grab",        2 },
    { "shop", "Pitchfork" },
    { "up",   "Pitchfork",   2 },
    { "shop", "Tnt" },
    { "up",   "Capacity",    3 },
    { "up",   "TntPower",    "max" },
    { "up",   "TntCooldown", 2 },
    { "shop", "Vacuum" },
    { "up",   "Grab",        "max" },   -- max Hand Grab
    { "up",   "Pitchfork",   "max" },   -- max Pitchfork Grab
    { "up",   "VacuumPower", "max" },   -- max Vacuum Power
    { "up",   "Speed",       "max" },   -- max Hand Speed
    { "up",   "DroneSpeed",  "max" },   -- max Drone Speed
    -- everything left over is bought after this (see start()).
}

function autoWinBg.active()
    return autoWinEnabled
        or autoWinBg.retires >= autoWinBg.threshold
end

-- Waits for money, then buys once. Returns true if bought, false when the
-- item is owned/maxed or the buyer was stopped.
function autoWinBg.waitBuy(token, remote, id, isShop)
    while gui and gui.Parent
        and token == autoWinBg.token
        and autoWinBg.active() do

        if isShop and autoWinFindOwnedTool(id) then
            return false
        end

        local st = autoWinBg.state[id]

        if st and st.maxedUntil and os.clock() < st.maxedUntil then
            return false
        end

        if autoWinBg.smartBuy(remote, id) then
            return true
        end

        task.wait(0.15)
    end

    return false
end

function autoWinBg.buyMax(token, id)
    local c = 0

    while c < AUTO_WIN_MAX_UPGRADE_ATTEMPTS
        and autoWinBg.waitBuy(token, BuyUpgradeRemote, id, false) do

        c += 1
        task.wait(autoWinBg.delay)
    end
end

function autoWinBg.start()
    if autoWinBg.started then
        return
    end

    autoWinBg.started = true
    autoWinBg.token += 1

    local token = autoWinBg.token

    task.spawn(function()
        while gui and gui.Parent
            and token == autoWinBg.token
            and autoWinBg.active() do

            pcall(function()
                for _, step in ipairs(autoWinBg.plan) do
                    local kind, id, n = step[1], step[2], step[3]

                    if token ~= autoWinBg.token
                        or not autoWinBg.active() then
                        return
                    end

                    if kind == "shop" then
                        if not autoWinFindOwnedTool(id) then
                            autoWinBg.status = "Waiting money: " .. id
                            autoWinBg.waitBuy(token, BuyShopRemote, id, true)
                        end
                    elseif n == "max" then
                        autoWinBg.status = "Max " .. id
                        autoWinBg.buyMax(token, id)
                    else
                        autoWinBg.status = id .. " x" .. tostring(n)

                        for _ = 1, n do
                            if not autoWinBg.waitBuy(
                                token, BuyUpgradeRemote, id, false
                            ) then
                                break
                            end

                            task.wait(autoWinBg.delay)
                        end
                    end
                end

                -- Everything else, in the order of the upgrade groups.
                for _, group in ipairs(upgradeGroups) do
                    for _, item in ipairs(group.items) do
                        if token ~= autoWinBg.token
                            or not autoWinBg.active() then
                            return
                        end

                        autoWinBg.status = "Max " .. tostring(item[1])
                        autoWinBg.buyMax(token, item[2])
                    end
                end

                autoWinBg.status = "All bought"
            end)

            task.wait(3)
        end

        if token == autoWinBg.token then
            autoWinBg.started = false
        end
    end)
end

function autoWinBg.registerRetire()
    autoWinBg.retires += 1

    -- A retire may reset upgrades/tools: forget learned prices and
    -- "maxed" flags so the plan checks everything again.
    autoWinBg.state = {}

    if autoWinBg.retires >= autoWinBg.threshold then
        autoWinBg.start()
    end
end

needleHandedHook = function()
