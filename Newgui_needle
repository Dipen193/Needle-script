        local char = player.Character
        local root = char
            and char:FindFirstChild("HumanoidRootPart")
        local pos = getNeedlePosition(needle)

        if not root or not pos then
            hideUI()
            return
        end

        local dist = (root.Position - pos).Magnitude
        trackerDist.Text = math.floor(dist + 0.5) .. " studs"

        local sp, onScreen = cam:WorldToViewportPoint(pos)
        local vp = cam.ViewportSize

        if onScreen
            and sp.Z > 0
            and sp.X >= 0 and sp.X <= vp.X
            and sp.Y >= 0 and sp.Y <= vp.Y then

            tracker.Visible = true
            arrow.Visible = false
            tracker.Position = UDim2.fromOffset(sp.X, sp.Y)
