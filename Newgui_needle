local AutoFarmGems = false
local TotalFarmedGems = 0
local gemPrompt = nil

local ArcadeFolder = ReplicatedStorage:WaitForChild("Arcade")
local ArcadeReport = ArcadeFolder:WaitForChild("ArcadeReport")
local ArcadeSession = ArcadeFolder:WaitForChild("ArcadeSession")

local function findGemPrompt()
	local machine = workspace:FindFirstChild("Arcade Machine", true)
	if machine then
		gemPrompt = machine:FindFirstChild("PlayPrompt", true)
	end
	if not gemPrompt then
		for _, object in ipairs(workspace:GetDescendants()) do
			if object:IsA("ProximityPrompt") and object.Name == "PlayPrompt" then
				gemPrompt = object
				break
			end
		end
	end
	if gemPrompt and gemPrompt.Parent then
		gemPrompt.HoldDuration = 0
		gemPrompt.MaxActivationDistance = math.huge
		gemPrompt.RequiresLineOfSight = false
		gemPrompt.ClickablePrompt = true
		return gemPrompt
	end
	return nil
end

