local function makeToggleWithSub(parent, text, subtext, yPos, callback, initial)
    label(parent, text, 14, WHITE, UDim2.fromOffset(16, yPos), UDim2.new(1, -100, 0, 20), Enum.Font.Gotham)
    if subtext then
        label(parent, subtext, 11, GRAY, UDim2.fromOffset(16, yPos + 18), UDim2.new(1, -100, 0, 16), Enum.Font.Gotham)
    end
    
    local bg = Instance.new("TextButton")
    bg.AutoButtonColor = false
    bg.Text = ""
    bg.BackgroundColor3 = OFF
    bg.BorderSizePixel = 0
    bg.AnchorPoint = Vector2.new(1, 0)
    bg.Position = UDim2.new(1, -16, 0, yPos + 8)
    bg.Size = UDim2.fromOffset(52, 24)
    bg.Parent = parent
    corner(bg, 12)
    
    local knob = Instance.new("Frame")
    knob.BackgroundColor3 = GRAY
    knob.BorderSizePixel = 0
    knob.Position = UDim2.fromOffset(3, 3)
    knob.Size = UDim2.fromOffset(18, 18)
    knob.Parent = bg
    corner(knob, 9)
    
    local state = initial == true
    local function paint()
        local info = TweenInfo.new(0.15)
        TweenService:Create(bg, info, {BackgroundColor3 = state and RED or OFF}):Play()
        TweenService:Create(knob, info, {
            Position = state and UDim2.fromOffset(31, 3) or UDim2.fromOffset(3, 3),
            BackgroundColor3 = state and WHITE or GRAY,
        }):Play()
    end
    paint()
    bg.MouseButton1Click:Connect(function()
        state = not state
        paint()
        callback(state)
    end)
    if initial == true then callback(true) end
    return function() return state end
end

local function makeToggle(parent, text, index, callback, initial)
    return makeToggleWithSub(parent, text, nil, 4 + (index - 1) * 38, callback, initial)
end

local function makeSlider(parent, text, y, min, max, default, callback)
    label(parent, text, 15, WHITE, UDim2.fromOffset(16, y), UDim2.fromOffset(200, 24), Enum.Font.Gotham)
    local track = frame(parent, Color3.fromRGB(28, 28, 34), UDim2.fromOffset(16, y + 34), UDim2.new(1, -112, 0, 6))
    corner(track, 3)
    local fill = frame(track, RED, UDim2.fromOffset(0, 0), UDim2.new(0, 0, 1, 0))
    corner(fill, 3)
    local knob = frame(track, RED, UDim2.new(0, 0, 0.5, 0), UDim2.fromOffset(18, 18))
    knob.AnchorPoint = Vector2.new(0.5, 0.5)
    corner(knob, 9)
    local valueBox = Instance.new("TextBox")
    valueBox.BackgroundColor3 = BG
    valueBox.BorderSizePixel = 0
    valueBox.AnchorPoint = Vector2.new(1, 0)
    valueBox.Position = UDim2.new(1, -16, 0, y + 12)
    valueBox.Size = UDim2.fromOffset(62, 32)
    valueBox.Font = Enum.Font.Gotham
    valueBox.TextSize = 17
    valueBox.TextColor3 = WHITE
    valueBox.ClearTextOnFocus = false
    valueBox.Text = tostring(default)
    valueBox.Parent = parent
    corner(valueBox, 6)
    stroke(valueBox, LINE, 1)
    local function setValue(v, fire)
        v = math.clamp(math.floor((tonumber(v) or default) + 0.5), min, max)
        local rel = (v - min) / math.max(1, max - min)
        fill.Size = UDim2.new(rel, 0, 1, 0)
        knob.Position = UDim2.new(rel, 0, 0.5, 0)
        valueBox.Text = tostring(v)
        if fire then callback(v) end
    end
    setValue(default, false)
    local hit = Instance.new("TextButton")
    hit.BackgroundTransparency = 1
    hit.Text = ""
    hit.Position = UDim2.fromOffset(-6, -10)
    hit.Size = UDim2.new(1, 12, 1, 20)
    hit.Parent = track
    local dragging = false
    local function fromX(x)
        local rel = math.clamp((x - track.AbsolutePosition.X) / math.max(1, track.AbsoluteSize.X), 0, 1)
        setValue(min + (max - min) * rel, true)
    end
    hit.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            fromX(i.Position.X)
        end
    end)
    UserInputService.InputChanged:Connect(function(i)
        if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then fromX(i.Position.X) end
    end)
    UserInputService.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then dragging = false end
    end)
    valueBox.FocusLost:Connect(function() setValue(valueBox.Text, true) end)
end

