-- ===== Visuals page =====
local visualsPage, visualsCard = makePage("Visuals", "Visuals", "Needle ESP.")

local needleESPEnabled = false
local needleESPHighlight
local needleESPConnection

local function removeNeedleESP()
	if needleESPConnection then
		needleESPConnection:Disconnect()
		needleESPConnection = nil
	end
	if needleESPHighlight then
		needleESPHighlight:Destroy()
		needleESPHighlight = nil
	end
end

local function createNeedleESP()
	removeNeedleESP()
	local target = workspace:FindFirstChild("Needle", true)
	local main = workspace:FindFirstChild("Main")
	if main then target = main:FindFirstChild("Needle") or target end
	if not target then return end
	local highlight = Instance.new("Highlight")
	highlight.Name = "NeedleESP"
	highlight.Adornee = target
	highlight.FillColor = Color3.fromRGB(255, 0, 0)
	highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
	highlight.FillTransparency = 0.3
	highlight.OutlineTransparency = 0
	highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	highlight.Parent = target
	needleESPHighlight = highlight

	needleESPConnection = workspace.DescendantAdded:Connect(function(obj)
		if needleESPEnabled and obj.Name == "Needle" then
			task.wait()
			if not needleESPHighlight or not needleESPHighlight.Parent then
				createNeedleESP()
			end
		end
	end)
end

makeToggle(visualsCard, "Needle ESP", 1, function(on)
	needleESPEnabled = on
	if on then
		createNeedleESP()
	else
		removeNeedleESP()
	end
end)

