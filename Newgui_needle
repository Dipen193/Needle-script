local classButtons = {}
local function updateSelectedCount()
	local count = 0
	for _ in pairs(selectedClasses) do count += 1 end
	selectedCount.Text = count == 0 and "0 selected" or (count .. " selected")
	selectClasses.Text = count == 0 and "Choose Classes  ▼" or (count .. " Classes  ▼")
end

for _, className in ipairs(classes) do
	local b = Instance.new("TextButton")
	b.Name = className:gsub("%s+", "")
	b.AutoButtonColor = false
	b.BackgroundColor3 = OFF
	b.BorderSizePixel = 0
	b.Text = "  " .. className
	b.TextXAlignment = Enum.TextXAlignment.Left
	b.Font = Enum.Font.GothamMedium
	b.TextSize = 12
	b.TextColor3 = WHITE
	b.Size = UDim2.new(1, -2, 0, 30)
	b.ZIndex = 102
	b.Parent = classList
	corner(b, 7)
	classButtons[className] = b

	b.MouseButton1Click:Connect(function()
		selectedClasses[className] = not selectedClasses[className] or nil
		if selectedClasses[className] then
			b.Text = "  ✓  " .. className
			b.TextColor3 = WHITE
			b.BackgroundColor3 = RED_DARK
		else
			b.Text = "  " .. className
			b.TextColor3 = WHITE
			b.BackgroundColor3 = OFF
		end
		updateSelectedCount()
	end)
end

clearClasses.MouseButton1Click:Connect(function()
	for className, b in pairs(classButtons) do
		selectedClasses[className] = nil
		b.Text = "  " .. className
		b.BackgroundColor3 = OFF
	end
	updateSelectedCount()
end)

selectClasses.MouseButton1Click:Connect(function()
	classDropdown.Visible = not classDropdown.Visible
	selectClasses.Text = classDropdown.Visible and "Close  ▲" or "Choose Classes  ▼"
	if classDropdown.Visible then
		-- Keep the picker above the rest of Home content.
		classDropdown.ZIndex = 100
	end
end)

rollClass.MouseButton1Click:Connect(function()
	if classRolling then
		classRolling = false
		rollClass.Text = "ROLL CLASSES"
		rollClass.BackgroundColor3 = OFF
		return
	end
	local count = 0
	for _ in pairs(selectedClasses) do count += 1 end
	if count == 0 then
		rollClass.Text = "SELECT FIRST"
		rollClass.BackgroundColor3 = RED
		task.delay(0.8, function()
			if not classRolling then
				rollClass.Text = "ROLL CLASSES"
				rollClass.BackgroundColor3 = OFF
			end
		end)
		return
	end
	classRolling = true
	rollClass.Text = "ROLLING..."
	rollClass.BackgroundColor3 = RED
end)

task.spawn(function()
	local Event = ReplicatedStorage:WaitForChild("ClassSystem"):WaitForChild("RollClass")
	while gui.Parent do
		task.wait(0.1)
		if classRolling then
			local ok, result = pcall(function() return Event:InvokeServer() end)
			if ok and type(result) == "table" and selectedClasses[result.className] then
				classRolling = false
				rollClass.Text = "✓ FOUND: " .. tostring(result.className)
				rollClass.BackgroundColor3 = RED
			end
		end
	end
end)

