-- Auto Pick Needle backend
local AutoPickNeedle = false
local needleCharacter, needleHumanoid, needleRootPart
local needle, needlePrompt
local needleFlyConnection
local needleCameraConnection
local needleFlying = false
local needleCameraFocused = false
local NEEDLE_FLY_SPEED = 25
local NEEDLE_DISTANCE_BEHIND = 3
local NEEDLE_INTERACTIONS = 3

local function needleGetCharacter()
	local char = player.Character
	if not char then return false end
	needleCharacter = char
	needleHumanoid = char:FindFirstChildOfClass("Humanoid")
	needleRootPart = char:FindFirstChild("HumanoidRootPart")
	return needleHumanoid ~= nil and needleRootPart ~= nil
end

local function getNeedle()
	local main = workspace:FindFirstChild("Main")
	if main then
		needle = main:FindFirstChild("Needle")
		if needle then
			needlePrompt = needle:FindFirstChild("NeedlePrompt", true)
		end
	end
	return needle
end

local function getNeedlePart()
	if not needle or not needle.Parent then return nil end
	if needle:IsA("BasePart") then return needle end
	if needle.PrimaryPart then return needle.PrimaryPart end
	return needle:FindFirstChildWhichIsA("BasePart", true)
end

local function stopNeedleFly()
	needleFlying = false
	if needleFlyConnection then
		needleFlyConnection:Disconnect()
		needleFlyConnection = nil
	end
	if needleRootPart then
		for _, obj in ipairs(needleRootPart:GetChildren()) do
			if obj.Name == "NeedleFlyVelocity" or obj.Name == "NeedleFlyGyro" then
				obj:Destroy()
			end
		end
	end
	if needleHumanoid then
		needleHumanoid.PlatformStand = false
	end
end

local function startNeedleFly()
	if not needleGetCharacter() then return end
	stopNeedleFly()
	needleFlying = true
	needleHumanoid:SetStateEnabled(Enum.HumanoidStateType.PlatformStanding, false)
	needleHumanoid.PlatformStand = true

	local bv = Instance.new("BodyVelocity")
	bv.Name = "NeedleFlyVelocity"
	bv.MaxForce = Vector3.new(1e9, 1e9, 1e9)
	bv.Velocity = Vector3.zero
	bv.Parent = needleRootPart

	local bg = Instance.new("BodyGyro")
	bg.Name = "NeedleFlyGyro"
	bg.MaxTorque = Vector3.new(1e9, 1e9, 1e9)
	bg.P = 9000
	bg.CFrame = needleRootPart.CFrame
	bg.Parent = needleRootPart

	needleFlyConnection = RunService.RenderStepped:Connect(function()
		if not AutoPickNeedle or not needleFlying or not needleRootPart or not needleRootPart.Parent then return end
		local cam = workspace.CurrentCamera
		if not cam then return end
		local cf = cam.CFrame
		local dir = Vector3.zero
		if UserInputService:IsKeyDown(Enum.KeyCode.W) then dir += cf.LookVector end
		if UserInputService:IsKeyDown(Enum.KeyCode.S) then dir -= cf.LookVector end
		if UserInputService:IsKeyDown(Enum.KeyCode.A) then dir -= cf.RightVector end
		if UserInputService:IsKeyDown(Enum.KeyCode.D) then dir += cf.RightVector end
		if UserInputService:IsKeyDown(Enum.KeyCode.Space) then dir += cf.UpVector end
		if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then dir -= cf.UpVector end
		if dir.Magnitude > 0 then dir = dir.Unit end
		bv.Velocity = dir * NEEDLE_FLY_SPEED
		if dir.Magnitude > 0 then
			bg.CFrame = needleRootPart.CFrame:Lerp(CFrame.lookAt(needleRootPart.Position, needleRootPart.Position + dir), 0.3)
		end
	end)
end

local function forceNeedleCamera()
	local cam = workspace.CurrentCamera
	if cam and needleHumanoid and needleHumanoid.Parent then
		cam.CameraType = Enum.CameraType.Custom
		cam.CameraSubject = needleHumanoid
	end
end

local function focusNeedleCamera()
	if needleCameraConnection then needleCameraConnection:Disconnect() end
	local cam = workspace.CurrentCamera
	local part = getNeedlePart()
	if not cam or not part or not needleRootPart then return end
	needleCameraFocused = true
	cam.CameraType = Enum.CameraType.Scriptable
	needleCameraConnection = RunService.RenderStepped:Connect(function()
		if not AutoPickNeedle or not needleCameraFocused then return end
		local currentPart = getNeedlePart()
		local currentCam = workspace.CurrentCamera
		if currentCam and currentPart and needleRootPart then
			local camPos = needleRootPart.Position + Vector3.new(0, 2, 5)
			currentCam.CFrame = CFrame.lookAt(camPos, currentPart.Position)
		end
	end)
end

local function unfocusNeedleCamera()
	needleCameraFocused = false
	if needleCameraConnection then
		needleCameraConnection:Disconnect()
		needleCameraConnection = nil
	end
	forceNeedleCamera()
end

local function needleTeleport()
	local part = getNeedlePart()
	if not part or not needleRootPart then return false end
	local backward = -part.CFrame.LookVector
	local pos = part.Position + backward * NEEDLE_DISTANCE_BEHIND
	pos = Vector3.new(pos.X, part.Position.Y, pos.Z)
	needleRootPart.CFrame = CFrame.lookAt(pos, part.Position)
	return true
end

local function needlePressE()
	local vim = game:GetService("VirtualInputManager")
	vim:SendKeyEvent(true, Enum.KeyCode.E, false, nil)
	task.wait(0.05)
	vim:SendKeyEvent(false, Enum.KeyCode.E, false, nil)
end

local function needleInteract()
	for _ = 1, NEEDLE_INTERACTIONS do
		if not AutoPickNeedle then return end
		needlePressE()
		task.wait(0.1)
	end
end

local function runAutoPickNeedle()
	if not AutoPickNeedle then return end
	if not needleGetCharacter() then return end
	if not getNeedle() then return end
	needleTeleport()
	focusNeedleCamera()
	needleInteract()
	unfocusNeedleCamera()
	startNeedleFly()
end

local function stopAutoPickNeedle()
	AutoPickNeedle = false
	unfocusNeedleCamera()
	stopNeedleFly()
	forceNeedleCamera()
end

makeToggle(card, "Auto Pick Needle", 1, function(on)
	if on then
		AutoPickNeedle = true
		task.spawn(runAutoPickNeedle)
	else
		stopAutoPickNeedle()
	end
end)

