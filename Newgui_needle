-- 5. Auto Collect Hay (3 Tools in 1)
local lastPitchfork = 0

local function getLookHay()
    refreshHayTools()
    if not hayFolder then return {} end
    local camera = workspace.CurrentCamera
    local origin = camera.CFrame.Position
    local direction = camera.CFrame.LookVector
    local candidates = {}

    for _, hay in ipairs(hayFolder:GetChildren()) do
        if hay.Name == "HayPiece" then
            local id = hay:GetAttribute("HayId")
            local pos = getHayPosition(hay)
            if id and pos then
                local offset = pos - origin
                local distance = offset.Magnitude
                if distance > 0 and distance <= 20 then
                    local dot = direction:Dot(offset.Unit)
                    if dot > 0 then
                        local angle = math.deg(math.acos(math.clamp(dot, -1, 1)))
                        if angle <= 35 then
                            table.insert(candidates, { id = id, distance = distance, angle = angle, position = pos })
                        end
                    end
                end
            end
        end
    end

    table.sort(candidates, function(a, b)
        if math.abs(a.angle - b.angle) < 5 then return a.distance < b.distance end
        return a.angle < b.angle
    end)
    return candidates
end

restartHayVacuum = function()
    refreshHayTools()
    if not VacuumAction then
        vacuumStarted = false
        return false
    end

    if vacuumStarted then
        pcall(function()
            VacuumAction:FireServer("Stop")
        end)
        vacuumStarted = false
        task.wait(0.05)
    end

    pcall(function()
        VacuumAction:FireServer("Start")
    end)
    vacuumStarted = true
    lastVacuumRefresh = os.clock()
    return true
end

task.spawn(function()
    while gui and gui.Parent do
        if autoCollectHay then
            refreshHayTools()

            -- If selling, let the sell routine handle the vacuum restart after
            -- the player returns. This prevents competing Stop/Start calls.
            if not isSellingHay then
                if not PickHay or not PitchforkDig or not VacuumAction or not hayFolder then
                    task.wait(0.5)
                    continue
                end

                -- The vacuum can silently stop on the server after a teleport
                -- or after a tool state changes. Re-start it automatically.
                if not vacuumStarted then
                    restartHayVacuum()
                end

                local candidates = getLookHay()
                if #candidates > 0 then
                    -- If the player left the hay area and later comes back,
                    -- refresh the server-side vacuum session. The old session
                    -- can remain true locally while no longer being active.
                    local now = os.clock()
                    if lastHaySeen > 0 and (now - lastHaySeen) >= 0.8 then
                        restartHayVacuum()
                    end
                    lastHaySeen = now

                    -- Also refresh periodically so a silent server-side
                    -- vacuum timeout cannot permanently kill Auto Collect.
                    if (now - lastVacuumRefresh) >= 8 then
                        restartHayVacuum()
                        lastVacuumRefresh = now
                    end

                    local pickIds, vacuumIds = {}, {}
                    for i = 1, math.min(#candidates, 12) do
                        table.insert(pickIds, candidates[i].id)
                    end
                    for i = 1, math.min(#candidates, 8) do
                        table.insert(vacuumIds, candidates[i].id)
                    end

                    local primaryId = pickIds[1]
                    local additionalIds = {}
                    for i = 2, #pickIds do
                        table.insert(additionalIds, pickIds[i])
                    end

                    -- Tool 1: Pick Hay
                    pcall(function()
                        PickHay:FireServer(primaryId, additionalIds)
                    end)

                    -- Tool 2: Pitchfork
                    if os.clock() - lastPitchfork >= 0.85 then
                        lastPitchfork = os.clock()
                        pcall(function()
                            PitchforkDig:FireServer(primaryId)
                        end)
                    end

                    -- Tool 3: Vacuum
                    if vacuumStarted and #vacuumIds > 0 then
                        local character = player.Character
                        local playerRoot = character and character:FindFirstChild("HumanoidRootPart")
                        if playerRoot then
                            pcall(function()
                                VacuumAction:FireServer(
                                    "Tick",
                                    playerRoot.Position,
                                    candidates[1].position,
                                    vacuumIds
                                )
                            end)
                        end
                    end
                end
            end

            task.wait(0.12)
        else
            task.wait(0.5)
        end
    end
end)

