local function getNeedleCandidates()
    local candidates = {}

    if not NeedleFolder then
        return candidates
    end

    local function addCandidate(obj)
        if not obj or obj == NeedleFolder then
            return
        end

        local name = obj.Name:lower()

        if name:find("needle", 1, true) then
            if obj:IsA("BasePart")
                or obj:IsA("Model") then

                table.insert(candidates, obj)
                return
            end

            local part =
                obj:FindFirstChildWhichIsA(
                    "BasePart",
                    true
                )

            if part then
                table.insert(candidates, obj)
                return
            end
        end

        if (
            obj:IsA("BasePart")
            or obj:IsA("Model")
        )
            and obj:FindFirstChildWhichIsA(
                "ProximityPrompt",
                true
            ) then

            table.insert(candidates, obj)
        end
    end

    for _, obj in ipairs(
        NeedleFolder:GetDescendants()
    ) do
        addCandidate(obj)
    end

    for _, obj in ipairs(
        NeedleFolder:GetChildren()
    ) do
        addCandidate(obj)
    end

    local unique = {}
    local result = {}

    for _, obj in ipairs(candidates) do
        if not unique[obj] then
            unique[obj] = true
            table.insert(result, obj)
        end
    end

    return result
end

local function getNeedle()
    local mainFolder =
        workspace:FindFirstChild("Main")

    local n =
        mainFolder
        and mainFolder:FindFirstChild("Needle")

    if n then
        return n
    end

    local candidates = getNeedleCandidates()

    for _, candidate in ipairs(candidates) do
        if candidate.Parent then
            return candidate
        end
    end

    return nil
end

local function getNeedlePosition(needle)
    if not needle then
        return nil
    end

    if needle:IsA("BasePart") then
        return needle.Position
    end

    if needle:IsA("Model") then
        if needle.PrimaryPart then
            return needle.PrimaryPart.Position
        end

        local part =
            needle:FindFirstChildWhichIsA(
                "BasePart",
                true
            )

        if part then
            return part.Position
        end
    end

    return nil
end

function NeedleX.mainNeedle()
    local m = workspace:FindFirstChild("Main")
    return m and m:FindFirstChild("Needle") or nil
end

-- True when the player is carrying the Needle (item in character/backpack
-- or a "has/carry/hold/pick needle" flag).
function NeedleX.carried()
    local function scan(c)
        if not c then
            return false
        end

        for _, o in ipairs(c:GetChildren()) do
            if o.Name:lower():find("needle", 1, true) then
                return true
            end
        end

        return false
    end

    if scan(player.Character)
        or scan(player:FindFirstChildOfClass("Backpack")) then
        return true
    end

    for _, holder in ipairs({ player, player.Character }) do
        if holder then
            for k, v in pairs(holder:GetAttributes()) do
                local n = tostring(k):lower()

                if v == true
                    and n:find("needle", 1, true)
                    and not n:find("lock", 1, true)
                    and (n:find("has", 1, true)
                        or n:find("carry", 1, true)
                        or n:find("hold", 1, true)
                        or n:find("pick", 1, true)
                        or n:find("grab", 1, true)) then

                    return true
                end
            end
        end
    end

    return false
end

-- Point the camera at the Needle: Auto Collect picks hay in front of the
-- camera, so the camera must look at the Needle area.
function NeedleX.aim(needle)
    local pos = needle and getNeedlePosition(needle)
    local cam = workspace.CurrentCamera

    refreshNeedleCharacter()

    if not (pos and cam and needleRoot) then
        return
    end

    pcall(function()
        cam.CameraType = Enum.CameraType.Scriptable
        cam.CFrame = CFrame.lookAt(
            needleRoot.Position + Vector3.new(0, 2, 0),
            pos
        )
    end)
end

local function equipTool(tool)
    refreshNeedleCharacter()

    if not needleHumanoid or not tool then
        return false
    end

    pcall(function()
        needleHumanoid:EquipTool(tool)
    end)

    task.wait(0.12)

    return tool.Parent == needleCharacter
end

local function getTools()
    local char = player.Character
    local backpack =
        player:FindFirstChildOfClass("Backpack")

    local found = {
        hay = {},
        vacuum = {},
        pitchfork = {},
        tnt = {}
    }

    local function scan(container)
        if not container then
            return
        end

        for _, obj in ipairs(
            container:GetChildren()
        ) do
            if obj:IsA("Tool") then
                local n = obj.Name:lower()

                if n:find("tnt") then
                    table.insert(found.tnt, obj)

                elseif n:find("vacuum") then
                    table.insert(found.vacuum, obj)

                elseif n:find("pitchfork")
                    or n:find("fork") then

                    table.insert(
                        found.pitchfork,
                        obj
                    )

                elseif n:find("hay")
                    or n:find("pick") then

                    table.insert(
                        found.hay,
                        obj
                    )
                end
            end
        end
    end

    scan(backpack)
    scan(char)

    return found
end

local function activateTool(
    tool,
    count,
    delayTime
)
    if not tool then
        return
    end

    count = count or 1
    delayTime = delayTime or 0.12

    refreshNeedleCharacter()

    if not needleHumanoid then
        return
    end

    equipTool(tool)

    for _ = 1, count do
        if not needleAuto then
            return
        end

        pcall(function()
            tool:Activate()
        end)

        task.wait(delayTime)
    end
end

local function throwTntAtNeedle(needle)
    if not TntAction or not HeldToolState or not needle then
        return false
    end

    refreshNeedleCharacter()
    local root = needleRoot
    local pos = getNeedlePosition(needle)
    if not root or not pos then
        return false
    end

    local startPosition = root.Position + Vector3.new(0, 3, 0)
    local directionVector = pos - startPosition
    if directionVector.Magnitude <= 0 then
        return false
    end

    local direction = directionVector.Unit
    local throwCFrame = CFrame.lookAt(startPosition, startPosition + direction)
    local velocity = direction * 65

    resetTntState()
    pcall(function() TntAction:FireServer("light") end)
    task.wait(0.48)
    pcall(function() HeldToolState:FireServer("Tnt", "lighting") end)
    task.wait(0.08)
    pcall(function() HeldToolState:FireServer("Tnt", "ready") end)
    task.wait(0.08)
    pcall(function() HeldToolState:FireServer("Tnt", "charging") end)
    task.wait(0.18)
    pcall(function() TntAction:FireServer("throw", throwCFrame, velocity) end)
    task.wait(0.1)
    resetTntState()
    return true
end

local function useAllToolsOnNeedle()
    local tools = getTools()

    -- Re-read the inventory every pass so newly purchased tools are used
    -- immediately without restarting Auto Win.
    if tools.hay[1] then
        activateTool(tools.hay[1], 2, 0.08)
    end

    if tools.pitchfork[1] then
        activateTool(tools.pitchfork[1], 3, 0.08)
    end

    if tools.vacuum[1] then
        activateTool(tools.vacuum[1], 3, 0.08)
    end

    -- TNT: real throw path at the Needle. Works with or without a TNT
    -- Tool in the bag (Auto TNT never needed one either).
    local needle = getNeedle()

    if needle and not tntBusy then
        tntBusy = true

        if tools.tnt[1] then
            equipTool(tools.tnt[1])
        end

        pcall(function()
            throwTntAtNeedle(needle)
        end)

        if tools.tnt[1] then
            pcall(function() tools.tnt[1]:Activate() end)
        end

        tntBusy = false
        task.wait(0.15)
    end
end

local function pickNeedleWithTools()
    -- Keep sell + dig + tools + TNT going until the Needle is picked.
    local deadline = os.clock() + 25
    local lastSell = os.clock()
    local hadMain = NeedleX.mainNeedle() ~= nil
    local picked = false

    while needleAuto and os.clock() < deadline do
        -- Picked = carried, or the real Main.Needle vanished, or no
        -- Needle object left at all.
        if NeedleX.carried()
            or (hadMain and not NeedleX.mainNeedle())
            or not getNeedle() then

            picked = true
            break
        end

        -- Keep the bag empty so the Needle can actually be picked up.
        if os.clock() - lastSell >= 8 then
            lastSell = os.clock()
            pcall(function() sellAndReturnHay() end)
            while isSellingHay do task.wait(0.05) end
        end

        -- Look at the Needle so Auto Collect (running in parallel) digs
        -- the hay around it, and dig the hay closest to it ourselves.
        NeedleX.aim(getNeedle())

        pcall(function()
            clearHayNearNeedle(getNeedle())
        end)

        -- ...then use hay pick + pitchfork + vacuum + TNT on it.
        useAllToolsOnNeedle()
        task.wait(0.1)
    end

    return picked
end

local function handInNeedleToNPC()
    NeedleX.handing = true

    local npcFolder = workspace:FindFirstChild("NPC")
    local npc = npcFolder and npcFolder:FindFirstChild("Farmer_NPC")

    local nh = ReplicatedStorage:FindFirstChild("NeedleHaystack")
        or ReplicatedStorage:WaitForChild("NeedleHaystack", 3)

    local remote = nh
        and (nh:FindFirstChild("NeedleHandIn")
            or nh:WaitForChild("NeedleHandIn", 3))

    if not remote then
        warn("[Needle] NeedleHandIn remote not found")
    end

    local function npcPosition()
        if not npc then
            return nil
        end

        local pos = getNeedlePosition(npc)

        if not pos then
            local okPivot, pivot = pcall(function()
                return npc:GetPivot().Position
            end)

            pos = okPivot and pivot or nil
        end

        return pos
    end

    -- Teleport ON the NPC, stay there and keep handing in until the
    -- Needle is gone from us (max ~4 seconds).
    local deadline = os.clock() + 4

    for attempt = 1, 8 do
        refreshNeedleCharacter()

        local pos = npcPosition()

        if needleRoot and pos then
            pcall(function()
                needleRoot.AssemblyLinearVelocity = Vector3.zero
                needleRoot.CFrame = CFrame.new(
                    pos + Vector3.new(0, 2, 2),
                    pos
                )
            end)
        end

        task.wait(0.15)

        if npc and fireproximityprompt then
            for _, d in ipairs(npc:GetDescendants()) do
                if d:IsA("ProximityPrompt") then
                    pcall(function() fireproximityprompt(d) end)
                end
            end
        end

        if remote then
            pcall(function()
                if remote:IsA("RemoteFunction") then
                    remote:InvokeServer()
                else
                    remote:FireServer()
                end
            end)
        end

        task.wait(0.25)

        -- Delivered once we no longer carry it (needs attempt >= 2 so
        -- the server had time to answer).
        if attempt >= 2 and not NeedleX.carried() then
            break
        end

        if os.clock() > deadline then
            break
        end
    end

    NeedleX.handing = false

    return true
end

local function processNeedleInner()
    local needle = getNeedle()

    -- Needle already picked (carried) but not delivered yet: go give it.
    if not needle then
        if NeedleX.carried()
            and os.clock() - (NeedleX.lastCarriedTrip or 0) > 3 then

            NeedleX.lastCarriedTrip = os.clock()
            handInNeedleToNPC()
        end

        return
    end

    refreshNeedleCharacter()

    -- Make the inventory empty first (sell all hay) so the Needle fits.
    pcall(function() sellAndReturnHay() end)
    while isSellingHay do
        task.wait(0.05)
    end

    needle = getNeedle() or needle
    refreshNeedleCharacter()

    local pos = getNeedlePosition(needle)

    if needleRoot and pos then
        pcall(function()
            needleRoot.CFrame = CFrame.new(
                pos + Vector3.new(0, 3, 3)
            )
        end)

        task.wait(0.35)

        if needleAuto then
            local picked =
                pickNeedleWithTools()

            if needleAuto then
                -- TP onto the Farmer NPC and give the Needle.
                handInNeedleToNPC()

                if picked and needleHandedHook then
                    pcall(needleHandedHook)
                end

                task.wait(0.5)
            end
        end
    end
end

local function processNeedleObjective()
    if needleBusy or not needleAuto then
        return
    end

    -- Only start when there is a Needle on the map or one in our hands.
    if not getNeedle() and not NeedleX.carried() then
        return
    end

    -- needleBusy pauses random TP / hay collect / sell / TNT for the
    -- whole trip. Always released, even if something errors.
    needleBusy = true

    local prevCollect = autoCollectHay
    local cam = workspace.CurrentCamera
    local prevCamType = cam and cam.CameraType

    -- Auto Collect (hay pick + pitchfork + vacuum) is what picks the
    -- Needle, so force it on for the trip.
    autoCollectHay = true
    refreshHayTools()
    pcall(function() restartHayVacuum() end)

    pcall(processNeedleInner)

    autoCollectHay = prevCollect
    NeedleX.handing = false

    if cam and prevCamType then
        pcall(function() cam.CameraType = prevCamType end)
    end

    needleBusy = false
end

local function startAutoNeedleLoop()
    task.spawn(function()
        while needleAuto
            and gui.Parent do

            pcall(processNeedleObjective)

            task.wait(0.35)
        end
    end)
end

local function stopAutoNeedle()
    needleBusy = false
end

