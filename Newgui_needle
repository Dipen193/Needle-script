--========================================================
-- MAIN FARM TOGGLE WITH SUBTEXT
--========================================================

local function makeFarmToggle(parent, title, subtitle, index, callback, initial)

    local y = 4 + (index - 1) * 53

    label(
        parent,
        title,
        15,
        WHITE,
        UDim2.fromOffset(16, y),
        UDim2.new(1, -100, 0, 22),
        Enum.Font.Gotham
    )

    label(
        parent,
        subtitle,
        11,
        GRAY,
        UDim2.fromOffset(16, y + 21),
        UDim2.new(1, -100, 0, 18),
        Enum.Font.Gotham
    )

    local bg = Instance.new("TextButton")
    bg.AutoButtonColor = false
    bg.Text = ""
    bg.BackgroundColor3 = OFF
    bg.BorderSizePixel = 0
    bg.AnchorPoint = Vector2.new(1, 0)
    bg.Position = UDim2.new(1, -16, 0, y + 10)
    bg.Size = UDim2.fromOffset(52, 24)
    bg.Parent = parent

    corner(bg, 12)

    local knob = Instance.new("Frame")
    knob.BackgroundColor3 = GRAY
    knob.BorderSizePixel = 0
    knob.Position = UDim2.fromOffset(3, 3)
    knob.Size = UDim2.fromOffset(18, 18)
    knob.Parent = bg

    corner(knob, 9)

    local state = initial == true

    local function paint()

        local info = TweenInfo.new(0.15)

        TweenService:Create(
            bg,
            info,
            {
                BackgroundColor3 =
                    state and RED or OFF
            }
        ):Play()

        TweenService:Create(
            knob,
            info,
            {
                Position =
                    state
                    and UDim2.fromOffset(31, 3)
                    or UDim2.fromOffset(3, 3),

                BackgroundColor3 =
                    state and WHITE or GRAY
            }
        ):Play()
    end

    paint()

    bg.MouseButton1Click:Connect(function()

        state = not state

        paint()

        callback(state)
    end)

    if initial == true then
        callback(true)
    end

    return function()
        return state
    end
end


