            local target = Vector2.new(sp.X, sp.Y)

            if sp.Z < 0 then
                target = center - (target - center)
            end

            local dir = target - center

            if dir.Magnitude < 1 then
                dir = Vector2.new(0, -1)
            else
                dir = dir.Unit
            end

            local margin = 45
            local halfX = (vp.X / 2) - margin
            local halfY = (vp.Y / 2) - margin
            local scaleX = halfX / math.max(math.abs(dir.X), 0.001)
            local scaleY = halfY / math.max(math.abs(dir.Y), 0.001)
            local arrowPos = center + dir * math.min(scaleX, scaleY)

            arrow.Position = UDim2.fromOffset(arrowPos.X, arrowPos.Y)
            arrow.Rotation =
                math.deg(math.atan2(dir.Y, dir.X)) + 90
        end
    end

