-- Every delivered Needle counts as one retire. After 8 retires
-- the tool/upgrade buyer runs in the background forever (until
-- the GUI is removed), independent of the Auto Win toggle/run.
-- ==========================================================
local autoWinFindOwnedTool -- forward declaration (defined below)
local autoWinBg = {
    threshold = 8,
    delay = 0.04,
    retires = 0,
    started = false,
    token = 0,
}

-- ---------- MONEY DETECTION ----------
autoWinBg.state = {}
autoWinBg.buying = false
autoWinBg.moneyGetter = nil
autoWinBg.moneySource = nil
autoWinBg.lastScan = 0

local MONEY_WORDS = { "money", "cash", "coin", "gold", "buck", "dollar", "currency", "balance" }
local MONEY_SKIP = { "gem", "price", "cost", "sell", "reward", "buy" }

local function nameHas(name, list)
    name = tostring(name):lower()

    for _, w in ipairs(list) do
        if name:find(w, 1, true) then
            return true
        end
    end

    return false
end

function autoWinBg.parse(text)
    if text == nil then
        return nil
    end

    text = tostring(text):gsub(",", "")

    local num, suf = text:match("(%d+%.?%d*)%s*([%a]*)")
    local n = tonumber(num)

    if not n then
        return nil
    end

    local map = {
        k = 1e3, m = 1e6, b = 1e9, t = 1e12, qa = 1e15,
        qi = 1e18, sx = 1e21, sp = 1e24, oc = 1e27,
        no = 1e30, dc = 1e33
    }

    return n * (map[(suf or ""):lower()] or 1)
end

function autoWinBg.scanMoney()
    autoWinBg.lastScan = os.clock()

    -- 1) leaderstats
    local ls = player:FindFirstChild("leaderstats")

    if ls then
        for _, v in ipairs(ls:GetChildren()) do
            if v:IsA("ValueBase")
                and nameHas(v.Name, MONEY_WORDS)
                and not nameHas(v.Name, MONEY_SKIP) then

                local ok, val = pcall(function() return v.Value end)

                if ok and tonumber(val) then
                    autoWinBg.moneySource = "leaderstats." .. v.Name
                    autoWinBg.moneyGetter = function()
                        return tonumber(v.Value)
                    end
                    return true
                end
            end
        end
    end

    -- 2) player attributes
    for k, v in pairs(player:GetAttributes()) do
        if type(v) == "number"
            and nameHas(k, MONEY_WORDS)
            and not nameHas(k, MONEY_SKIP) then

            autoWinBg.moneySource = "attribute " .. k
            autoWinBg.moneyGetter = function()
                return tonumber(player:GetAttribute(k))
            end
            return true
        end
    end

    -- 3) on-screen labels (stats UI first, then the whole PlayerGui)
    local pg = player:FindFirstChild("PlayerGui")

    local function isMoneyLabel(obj)
        if not (obj:IsA("TextLabel") or obj:IsA("TextButton")) then
            return false
        end

        if gui and obj:IsDescendantOf(gui) then
            return false
        end

        if not tostring(obj.Text):find("%d") then
            return false
        end

        local n1 = obj.Name
        local n2 = obj.Parent and obj.Parent.Name or ""

        if nameHas(n1, MONEY_SKIP) or nameHas(n2, MONEY_SKIP) then
            return false
        end

        return nameHas(n1, MONEY_WORDS) or nameHas(n2, MONEY_WORDS)
    end

    local roots = {}

    if pg then
        local stats = pg:FindFirstChild("PlayerStatsUI")
        if stats then table.insert(roots, stats) end
        table.insert(roots, pg)
    end

    for _, root in ipairs(roots) do
        for _, obj in ipairs(root:GetDescendants()) do
            if isMoneyLabel(obj) then
                autoWinBg.moneySource = obj:GetFullName()
                autoWinBg.moneyGetter = function()
                    return autoWinBg.parse(obj.Text)
                end
                return true
            end
        end
    end

    -- 4) any label whose text starts with "$"
    if pg then
        for _, obj in ipairs(pg:GetDescendants()) do
            if (obj:IsA("TextLabel") or obj:IsA("TextButton"))
                and not (gui and obj:IsDescendantOf(gui))
                and tostring(obj.Text):match("^%s*%$%s*%d")
                and not nameHas(obj.Name, MONEY_SKIP) then

                autoWinBg.moneySource = obj:GetFullName()
                autoWinBg.moneyGetter = function()
                    return autoWinBg.parse(obj.Text)
                end
                return true
            end
        end
    end

    autoWinBg.moneyGetter = nil
    autoWinBg.moneySource = nil
    return false
end

function autoWinBg.getMoney()
    if not autoWinBg.moneyGetter
        and os.clock() - autoWinBg.lastScan >= 4 then
        pcall(autoWinBg.scanMoney)
    end

    local g = autoWinBg.moneyGetter

    if not g then
        return nil
    end

    local ok, v = pcall(g)

    if ok and type(v) == "number" then
        return v
    end

    -- Source label/value was destroyed - rescan next call.
    autoWinBg.moneyGetter = nil
    return nil
end

-- Best effort: a UI row named like the upgrade that shows "MAX".
function autoWinBg.uiMaxed(id)
    local pg = player:FindFirstChild("PlayerGui")

    if not pg then
        return false
    end

    local want = tostring(id):lower()
    local found = false

    pcall(function()
        for _, obj in ipairs(pg:GetDescendants()) do
            if not (gui and obj:IsDescendantOf(gui))
                and obj.Name:lower():find(want, 1, true)
                and not (obj:IsA("TextLabel") or obj:IsA("TextButton")) then

                for _, t in ipairs(obj:GetDescendants()) do
                    if (t:IsA("TextLabel") or t:IsA("TextButton"))
                        and tostring(t.Text):lower():match("^%s*max") then

                        found = true
                        return
                    end
                end
            end
        end
    end)

    return found
end

-- ---------- BUY ONLY WHEN WE HAVE MONEY ----------
-- Returns true only when a purchase really went through.
-- Learns each item's price from the money that was spent, and learns a
-- price lower bound from every failed try, so we never spam buys we
-- cannot afford.
function autoWinBg.smartBuy(remote, id)
    local st = autoWinBg.state[id]

    if not st then
        st = { need = 0, nextTry = 0, fails = 0 }
        autoWinBg.state[id] = st
    end

    if os.clock() < st.nextTry then
        return false
    end

    if st.maxedUntil and os.clock() < st.maxedUntil then
        return false
    end

    while autoWinBg.buying do
        task.wait(0.02)
    end

    autoWinBg.buying = true

    local ok, res = pcall(function()
        local before = autoWinBg.getMoney()

        if before and before < st.need then
            st.nextTry = os.clock() + 0.2
            return false
        end

        fireBuy(remote, id)

        -- Money unreadable: cannot verify, so fall back to a slow cooldown.
        if not before then
            st.nextTry = os.clock() + 1
            return true
        end

        local after = before
        local deadline = os.clock() + 0.6

        while os.clock() < deadline do
            task.wait(0.05)
            after = autoWinBg.getMoney() or before

            if after < before then
                break
            end
        end

        if after < before then
            st.need = before - after
            st.price = before - after
            st.fails = 0
            return true
        end

        st.fails += 1

        if st.fails == 1 then
            st.streakMoney = before
        end

        st.need = before + 1
        st.nextTry = os.clock() + math.min(1 + st.fails, 5)

        -- Not a money problem -> it is maxed / locked. Detect it fast:
        --  * the shop UI says MAX for this item, or
        --  * we can afford 3x the last price we paid and it still fails, or
        --  * money doubled since the first failure and it still fails, or
        --  * it was maxed before and fails again.
        local maxed = autoWinBg.uiMaxed(id)
            or (st.price and st.fails >= 2 and before >= st.price * 3)
            or (st.fails >= 3
                and (st.streakMoney or 0) > 0
                and before >= st.streakMoney * 2)
            or (st.everMaxed and st.fails >= 1)
            or st.fails >= 10

        if maxed then
            st.everMaxed = true
            st.maxedUntil = os.clock() + 90
            st.fails = 0
            st.need = 0
        end

        return false
    end)

    autoWinBg.buying = false

    return ok and res == true
end

