local autoEntries = {}

local function fireBuy(remote, id)
    if not remote then
        return false
    end

    local ok, err = pcall(function()
        remote:FireServer(id)
    end)

    if not ok then
        warn(
            "Buy failed:",
            id,
            err
        )
    end

    return ok
end

local function makeBuyRow(
    parent,
    order,
    displayName,
    remote,
    id,
    buyText
)
    local row = Instance.new("Frame")
    row.BackgroundColor3 = BG
    row.BorderSizePixel = 0
    row.Size = UDim2.new(1, 0, 0, 38)
    row.LayoutOrder = order
    row.Parent = parent

    corner(row, 8)
    stroke(row, LINE, 1)

    label(
        row,
        displayName,
        14,
        WHITE,
        UDim2.fromOffset(12, 0),
        UDim2.new(1, -150, 1, 0),
        Enum.Font.Gotham
    )

    local buy = Instance.new("TextButton")
    buy.AutoButtonColor = false
    buy.BackgroundColor3 = RED_DARK
    buy.BorderSizePixel = 0
    buy.Text = buyText
    buy.Font = Enum.Font.GothamMedium
    buy.TextSize = 13
    buy.TextColor3 = WHITE
    buy.AnchorPoint = Vector2.new(1, 0.5)
    buy.Position = UDim2.new(
        1,
        -68,
        0.5,
        0
    )
    buy.Size = UDim2.fromOffset(72, 26)
    buy.Parent = row

    corner(buy, 6)

    buy.MouseButton1Click:Connect(function()
        local ok =
            fireBuy(
                remote,
                id
            )

        buy.BackgroundColor3 =
            ok
            and Color3.fromRGB(
                45,
                145,
                75
            )
            or Color3.fromRGB(
                160,
                45,
                45
            )

        task.delay(0.3, function()
            if buy and buy.Parent then
                buy.BackgroundColor3 =
                    RED_DARK
            end
        end)
    end)

    local bg = Instance.new("TextButton")
    bg.AutoButtonColor = false
    bg.Text = ""
    bg.BackgroundColor3 = OFF
    bg.BorderSizePixel = 0
    bg.AnchorPoint = Vector2.new(1, 0.5)
    bg.Position = UDim2.new(
        1,
