--========================================================
-- AUTO PICK GEMS
--========================================================

local autoPickGems = false
local gemCollectConnection = nil
local collectedGemIds = {}

local GemsClient =
    workspace:WaitForChild(
        "GemsClient"
    )

local CollectGem =
    ReplicatedStorage
        :WaitForChild(
            "NeedleHaystack"
        )
        :WaitForChild(
            "CollectGem"
        )


local function collectGemObject(gem)

    if
        not autoPickGems
        or not gem
        or not gem.Parent
    then
        return
    end

    local id =
        tonumber(
            gem.Name:match(
                "^Gem_(%d+)$"
            )
        )

    if not id then
        return
    end

    if collectedGemIds[id] then
        return
    end

    collectedGemIds[id] = true


    pcall(function()

        CollectGem:FireServer(
            id
        )

    end)


    task.delay(
        1,
        function()

            if
                not gem
                or not gem.Parent
            then

                collectedGemIds[id] = nil
            end
        end
    )
end


local function scanExistingGems()

    for _, gem in ipairs(
        GemsClient:GetChildren()
    ) do

        if gem.Name:match(
            "^Gem_%d+$"
        ) then

            collectGemObject(
                gem
            )
        end
    end
end


local function startAutoPickGems()

    if gemCollectConnection then

        gemCollectConnection:Disconnect()

        gemCollectConnection = nil
    end

    table.clear(
        collectedGemIds
    )

    scanExistingGems()


    gemCollectConnection =
        GemsClient.ChildAdded:Connect(
            function(gem)

                if not autoPickGems then
                    return
                end

                task.wait()

                collectGemObject(
                    gem
                )
            end
        )
end


local function stopAutoPickGems()

    if gemCollectConnection then

        gemCollectConnection:Disconnect()

        gemCollectConnection = nil
    end

    table.clear(
        collectedGemIds
    )
end


makeFarmToggle(
    combatCard,
    "Auto Pick Gems",
    "Automatically collect spawned gems.",
    5,
    function(on)

        autoPickGems = on

        if on then
            startAutoPickGems()
        else
            stopAutoPickGems()
        end
    end
)


