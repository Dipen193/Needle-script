local needleAuto = false
local needleCharacter
local needleHumanoid
local needleRoot

local needleFlyConnection
local needleCameraConnection

local needleCameraFocused = false
local needleFlying = false

local needleSpeed = 50
local needleInteractions = 3


local function refreshNeedleCharacter(char)

    needleCharacter = char

    needleHumanoid =
        char and char:FindFirstChildOfClass("Humanoid")

    needleRoot =
        char and char:FindFirstChild("HumanoidRootPart")
end


