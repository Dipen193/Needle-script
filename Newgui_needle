local TntAction = nil
local HeldToolState = nil
local PickHay = nil
local PitchforkDig = nil
local hayFolder = nil

local function refreshHayTools()
    NH =
        ReplicatedStorage:FindFirstChild(
            "NeedleHaystack"
        )

    TntAction =
