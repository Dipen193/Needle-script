-- 5. Auto Collect Hay
local lastPitchfork = 0

local function getLookHay()
    refreshHayTools()

    if not hayFolder then
        return {}
    end

    local camera = workspace.CurrentCamera

    local origin = camera.CFrame.Position
    local direction = camera.CFrame.LookVector

    local candidates = {}

    for _, hay in ipairs(
        hayFolder:GetChildren()
    ) do

        if hay.Name == "HayPiece" then
            local id =
                hay:GetAttribute("HayId")

            local pos =
                getHayPosition(hay)

            if id and pos then
                local offset = pos - origin
                local distance = offset.Magnitude

                if distance > 0
                    and distance <= 20 then

                    local dot =
                        direction:Dot(
                            offset.Unit
                        )

                    if dot > 0 then
                        local angle =
                            math.deg(
                                math.acos(
                                    math.clamp(
                                        dot,
                                        -1,
                                        1
                                    )
                                )
                            )

                        if angle <= 35 then
                            table.insert(
                                candidates,
                                {
                                    id = id,
                                    distance = distance,
                                    angle = angle,
                                    position = pos
                                }
                            )
                        end
                    end
                end
            end
        end
    end

    table.sort(
        candidates,
        function(a, b)
            if math.abs(
                a.angle - b.angle
            ) < 5 then

                return a.distance
                    < b.distance
            end

            return a.angle < b.angle
        end
    )

    return candidates
end

restartHayVacuum = function()
    refreshHayTools()

    if not VacuumAction then
        vacuumStarted = false
        return false
    end

    if vacuumStarted then
        pcall(function()
            VacuumAction:FireServer("Stop")
        end)

        vacuumStarted = false
        task.wait(0.05)
    end

    pcall(function()
        VacuumAction:FireServer("Start")
    end)

    vacuumStarted = true
    lastVacuumRefresh = os.clock()

    return true
end

task.spawn(function()
    while gui and gui.Parent do
        if autoCollectHay
            and not NeedleX.handing then
            refreshHayTools()

            if not isSellingHay then
                if not PickHay
                    or not PitchforkDig
                    or not VacuumAction
                    or not hayFolder then

                    task.wait(0.5)
                    continue
                end

                if not vacuumStarted then
                    restartHayVacuum()
                end

                local candidates =
                    getLookHay()

                if #candidates > 0 then
                    local now = os.clock()

                    if lastHaySeen > 0
                        and now - lastHaySeen >= 0.8 then

                        restartHayVacuum()
                    end

                    lastHaySeen = now

                    if now - lastVacuumRefresh >= 8 then
                        restartHayVacuum()
                        lastVacuumRefresh = now
                    end

                    local pickIds = {}
                    local vacuumIds = {}

                    for i = 1,
                        math.min(
                            #candidates,
                            12
                        ) do

                        table.insert(
                            pickIds,
                            candidates[i].id
                        )
                    end

                    for i = 1,
                        math.min(
                            #candidates,
                            8
                        ) do

                        table.insert(
                            vacuumIds,
                            candidates[i].id
                        )
                    end

                    local primaryId =
                        pickIds[1]

                    local additionalIds = {}

                    for i = 2,
                        #pickIds do

                        table.insert(
                            additionalIds,
                            pickIds[i]
                        )
                    end

                    pcall(function()
                        PickHay:FireServer(
                            primaryId,
                            additionalIds
                        )
                    end)

                    if os.clock()
                        - lastPitchfork
                        >= NeedleX.pitchforkInterval then

                        lastPitchfork = os.clock()

                        -- Rotate through the nearby hay so the pitchfork
                        -- does not dig the same piece the hand is taking.
                        NeedleX.pfIndex = (NeedleX.pfIndex or 0) % #pickIds + 1

                        local pitchforkId =
                            pickIds[NeedleX.pfIndex]
                            or primaryId

                        pcall(function()
                            PitchforkDig:FireServer(
                                pitchforkId
                            )
                        end)
                    end

                    if vacuumStarted
                        and #vacuumIds > 0 then

                        local character =
                            player.Character

                        local playerRoot =
                            character
                            and character:FindFirstChild(
                                "HumanoidRootPart"
                            )

                        if playerRoot then
                            pcall(function()
                                VacuumAction:FireServer(
                                    "Tick",
                                    playerRoot.Position,
                                    candidates[1].position,
                                    vacuumIds
                                )
                            end)
                        end
                    end
                end
            end

            task.wait(0.12)
        else
            task.wait(0.5)
        end
    end
end)

clearHayNearNeedle = function(needle)
    refreshHayTools()

    local needlePos = getNeedlePosition(needle)

    if not needlePos or not hayFolder or not PickHay then
        return 0
    end

    local list = {}

    -- If the Needle itself is a collectable with an id, target it first.
    for k, v in pairs(needle:GetAttributes()) do
        if tostring(k):lower():find("hayid", 1, true) then
            table.insert(list, {
                id = v,
                pos = needlePos,
                distance = -1
            })
        end
    end

    for _, hay in ipairs(hayFolder:GetChildren()) do
        if hay.Name == "HayPiece" then
            local id = hay:GetAttribute("HayId")
            local pos = getHayPosition(hay)

            if id and pos then
                local d = (pos - needlePos).Magnitude

                if d <= 40 then
                    table.insert(list, {
                        id = id,
                        pos = pos,
                        distance = d
                    })
                end
            end
        end
    end

    if #list == 0 then
        return 0
    end

    -- Hay closest to the Needle first.
    table.sort(list, function(a, b)
        return a.distance < b.distance
    end)

    local primary = list[1].id
    local extra = {}
    local vacIds = {}

    for i = 2, math.min(#list, 12) do
        table.insert(extra, list[i].id)
    end

    for i = 1, math.min(#list, 8) do
        table.insert(vacIds, list[i].id)
    end

    pcall(function()
        PickHay:FireServer(primary, extra)
    end)

    if PitchforkDig then
        pcall(function()
            PitchforkDig:FireServer(primary)
        end)
    end

    if VacuumAction then
        if not vacuumStarted then
            restartHayVacuum()
        end

        refreshNeedleCharacter()

        if needleRoot then
            pcall(function()
                VacuumAction:FireServer(
                    "Tick",
                    needleRoot.Position,
                    list[1].pos,
                    vacIds
                )
            end)
        end
    end

    return #list
end

