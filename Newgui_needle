-- Shared hay state is declared before Auto Sell because selling can restart
-- the vacuum after teleporting.
local autoCollectHay = false
local vacuumStarted = false
local VacuumAction = nil
local lastHaySeen = 0
local lastVacuumRefresh = 0
-- 2. Auto Sell Hay
local autoSellHay = false
local isSellingHay = false
local restartHayVacuum -- assigned after the hay-tool functions are created

-- Read a number even if the game's UI formats it like "12/20", "12 / 20",
-- "12 Hay", etc. This makes the sell check work even when the inventory
-- temporarily goes OVER the displayed maximum.
local function readFirstNumber(value)
    if value == nil then return nil end
    -- Roblox UI can format hay amounts with thousands separators, e.g.
    -- "1,207". Remove commas before converting so overflow is detected.
    local text = tostring(value):gsub(",", "")
    local numberText = text:match("%-?%d+%.?%d*")
    return numberText and tonumber(numberText) or nil
end

local function readCapacityPair(value)
    if value == nil then return nil, nil end
    -- Supports "953/1,207", "953 / 1,207", etc.
    local text = tostring(value):gsub(",", "")
    local a, b = text:match("(%d+)%s*/%s*(%d+)")
    if a and b then
        return tonumber(a), tonumber(b)
    end
    return nil, nil
end

local function sellAndReturnHay()
    if isSellingHay then return end
    isSellingHay = true

    -- Stop the vacuum BEFORE teleporting. Leaving it running while moving to
    -- the sell area can leave the server-side vacuum session invalid.
    if vacuumStarted and VacuumAction then
        pcall(function()
            VacuumAction:FireServer("Stop")
        end)
        vacuumStarted = false
    end

    pcall(function()
        local char = player.Character or player.CharacterAdded:Wait()
        local root = char:WaitForChild("HumanoidRootPart")
        local sellPart = workspace:WaitForChild("SellModel"):WaitForChild("SellPart")
        local sellEvent = ReplicatedStorage:WaitForChild("NeedleHaystack"):WaitForChild("SellHay")

        local originalCFrame = root.CFrame
        root.CFrame = sellPart.CFrame + Vector3.new(0, 3, 0)

        task.wait(0.25)
        sellEvent:FireServer()
        task.wait(0.45)

        if root and root.Parent then
            root.CFrame = originalCFrame
        end

        -- Start a fresh vacuum session after returning to the hay area.
        task.wait(0.15)
        if autoCollectHay and restartHayVacuum then
            restartHayVacuum()
        end
    end)

    isSellingHay = false
end

task.spawn(function()
    while gui and gui.Parent do
        if autoSellHay and not isSellingHay then
            pcall(function()
                local playerGui = player:FindFirstChild("PlayerGui")
                local hud = playerGui and playerGui:FindFirstChild("HUD")

                -- Do not depend on one exact HUD layout. The game can rebuild
                -- the Capacity UI, and the text can temporarily show overflow.
                local function findDescendant(parent, name)
                    if not parent then return nil end
                    local direct = parent:FindFirstChild(name)
                    if direct then return direct end
                    for _, obj in ipairs(parent:GetDescendants()) do
                        if obj.Name == name then
                            return obj
                        end
                    end
                    return nil
                end

                local capacityUI = findDescendant(hud, "Capacity")
                local currentAmount = findDescendant(capacityUI or hud, "CurrentAmount")
                local totalCapacity = findDescendant(capacityUI or hud, "TotalCapacity")

                local function textValue(obj)
                    if not obj then return nil end
                    if obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox") then
                        return obj.Text
                    end
                    local ok, value = pcall(function() return obj.Value end)
                    if ok and value ~= nil then return tostring(value) end
                    return nil
                end

                local currentText = textValue(currentAmount)
                local maxText = textValue(totalCapacity)
                local current = readFirstNumber(currentText)
                local maximum = readFirstNumber(maxText)

                -- The game's BottomLeft.Capacity UI uses separate labels for
                -- current hay and maximum capacity. The current label can be
                -- formatted with commas, e.g. "1,207", so parse the FULL
                -- number rather than stopping at the first digit.
                --
                -- Capacity display may also be a single "MAX/CURRENT" label.
                -- In that format the FIRST number is MAX and the SECOND is
                -- CURRENT, and CURRENT is allowed to overflow indefinitely.
                local pairMax, pairCurrent = readCapacityPair(currentText)
                if pairMax and pairCurrent then
                    maximum = pairMax
                    current = pairCurrent
                end
                local pairMax2, pairCurrent2 = readCapacityPair(maxText)
                if pairMax2 and pairCurrent2 then
                    maximum = pairMax2
                    current = pairCurrent2
                end

                -- If the named TotalCapacity node was rebuilt/missing, look
                -- for a capacity-like text containing a slash as a fallback.
                if not maximum and hud then
                    for _, obj in ipairs(hud:GetDescendants()) do
                        if obj:IsA("TextLabel") or obj:IsA("TextButton") then
                            local txt = tostring(obj.Text or ""):gsub(",", "")
                            local a, b = txt:match("(%d+)%s*/%s*(%d+)")
                            if a and b then
                                -- Capacity text is MAX/CURRENT. Keep the
                                -- overflow value exactly as displayed.
                                maximum = tonumber(a)
                                current = tonumber(b)
                                break
                            end
                        end
                    end
                end

                -- >= is intentional: this catches both exactly-full and
                -- OVERFLOW inventories (e.g. 241/240).
                if current and maximum and maximum > 0 and current >= maximum then
                    sellAndReturnHay()
                end
            end)
        end
        task.wait(0.15)
    end
end)

