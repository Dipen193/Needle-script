-- 5. Auto Collect Hay
local lastPitchfork = 0

local function getLookHay()
    refreshHayTools()

    if not hayFolder then
        return {}
    end

    local camera = workspace.CurrentCamera

    local origin = camera.CFrame.Position
    local direction = camera.CFrame.LookVector

    local candidates = {}

    for _, hay in ipairs(
        hayFolder:GetChildren()
    ) do

        if hay.Name == "HayPiece" then
            local id =
                hay:GetAttribute("HayId")

            local pos =
                getHayPosition(hay)

            if id and pos then
                local offset = pos - origin
                local distance = offset.Magnitude

                if distance > 0
                    and distance <= 20 then

                    local dot =
                        direction:Dot(
                            offset.Unit
                        )

                    if dot > 0 then
                        local angle =
                            math.deg(
                                math.acos(
                                    math.clamp(
                                        dot,
                                        -1,
                                        1
                                    )
                                )
                            )

                        if angle <= 35 then
                            table.insert(
                                candidates,
                                {
                                    id = id,
                                    distance = distance,
                                    angle = angle,
                                    position = pos
                                }
                            )
                        end
                    end
                end
            end
        end
    end

    table.sort(
        candidates,
        function(a, b)
            if math.abs(
                a.angle - b.angle
            ) < 5 then

                return a.distance
                    < b.distance
            end

            return a.angle < b.angle
        end
    )

    return candidates
end

restartHayVacuum = function()
    refreshHayTools()

    if not VacuumAction then
        vacuumStarted = false
        return false
    end

    if vacuumStarted then
        pcall(function()
            VacuumAction:FireServer("Stop")
        end)

        vacuumStarted = false
        task.wait(0.05)
    end

    pcall(function()
        VacuumAction:FireServer("Start")
    end)

    vacuumStarted = true
    lastVacuumRefresh = os.clock()

    return true
end

