end

local function autoWinHandleNeedle(runId)
    if not autoWinEnabled or runId ~= autoWinRunId then
        return false
    end

    if not autoWinIsNeedlePresent() then
        return false
    end

    autoWinSetStatus("Needle found - delivering")

    -- Needle is the main objective. Stop hay-side automation from
    -- competing for the character while the needle is handled.
    needleAuto = true

    pcall(function()
        processNeedleObjective()
    end)

    local deadline = os.clock() + 10

    while autoWinEnabled
        and runId == autoWinRunId
        and autoWinIsNeedlePresent()
        and os.clock() < deadline do

        -- A direct retry keeps delivery reliable even if the normal
        -- needle worker was between iterations when the needle appeared.
        pcall(function()
            processNeedleObjective()
        end)

        task.wait(0.2)
    end

    if autoWinEnabled and runId == autoWinRunId then
        if autoWinIsNeedlePresent() then
            autoWinSetStatus("Needle still present - retrying")
            return false
        end

        autoWinSetStatus("Needle delivered")
        return true
    end

    return false
end

local function autoWinCheckPriority(runId)
    if not autoWinEnabled or runId ~= autoWinRunId then
        return true
    end

    if autoWinIsNeedlePresent() then
        -- Returning true means the main objective was completed and the
        -- remaining upgrade sequence should not delay the win.
        if autoWinHandleNeedle(runId) then
            return true
        end
    end

    return false
end

local function autoWinBuyUpgrade(id, count, runId)
    count = count or 1

    for _ = 1, count do
        local deadline = os.clock() + 20
        local bought = false

        while not bought and os.clock() < deadline do
            if not autoWinEnabled or runId ~= autoWinRunId then
                return false
            end

            if autoWinCheckPriority(runId) then
                return true
            end

            bought = autoWinBg.smartBuy(BuyUpgradeRemote, id)

            if not bought then
                task.wait(0.15)
            end
        end

        if bought then
            task.wait(AUTO_WIN_STEP_DELAY)
        end
    end

    return false
end

function autoWinFindOwnedTool(id)
    -- The game can keep purchased tools in different containers and they
    -- are not always direct children of Backpack/Character. Search
    -- recursively so an already-owned item never causes an infinite buy loop.
    local wanted = tostring(id):lower()

    local function matches(name)
        name = tostring(name):lower()

        if wanted == "pitchfork" then
            return name:find("pitchfork", 1, true) ~= nil
                or name:find("fork", 1, true) ~= nil
        elseif wanted == "tnt" then
            return name:find("tnt", 1, true) ~= nil
        elseif wanted == "vacuum" then
            return name:find("vacuum", 1, true) ~= nil
        end

        return name == wanted or name:find(wanted, 1, true) ~= nil
    end

    local function scan(container)
        if not container then
            return nil
        end

        for _, obj in ipairs(container:GetDescendants()) do
            if obj:IsA("Tool") and matches(obj.Name) then
                return obj
            end
        end

        -- Also handle a container that itself is the Tool.
        if container:IsA("Tool") and matches(container.Name) then
            return container
        end

        return nil
    end

    local char = player.Character
    local backpack = player:FindFirstChildOfClass("Backpack")
    local starterGear = player:FindFirstChild("StarterGear")

    -- Character first because an equipped item is considered owned too.
    return scan(char)
        or scan(backpack)
        or scan(starterGear)
end

local function autoWinBuyShopItem(id, runId)
    if not autoWinEnabled or runId ~= autoWinRunId then
        return false
    end

    -- First, ALWAYS check whether it is already owned.
    local owned = autoWinFindOwnedTool(id)
    if owned then
        autoWinSetStatus(tostring(id) .. " already owned")
        return false
    end

    -- Retry the purchase, but never wait forever. Some games do not expose
    -- ownership as a Tool immediately, even though the purchase succeeded.
    -- After the attempts, continue the Auto Win sequence and let the tool
    -- scanner pick it up when it appears.
    local maxAttempts = 40

    for attempt = 1, maxAttempts do
        if not autoWinEnabled or runId ~= autoWinRunId then
            return false
        end

        if autoWinCheckPriority(runId) then
            return true
        end

        owned = autoWinFindOwnedTool(id)
        if owned then
            autoWinSetStatus(tostring(id) .. " owned")
            return false
        end

        autoWinSetStatus("Buying " .. tostring(id) .. " (" .. tostring(attempt) .. "/" .. tostring(maxAttempts) .. ")")
        autoWinBg.smartBuy(BuyShopRemote, id)

        local deadline = os.clock() + 0.5
        while os.clock() < deadline do
            task.wait(0.1)

            owned = autoWinFindOwnedTool(id)
            if owned then
                autoWinSetStatus(tostring(id) .. " owned")
                return false
            end

            if autoWinCheckPriority(runId) then
                return true
            end
        end
    end

    -- Do not get stuck here. The server may have accepted the purchase even
    -- if no Tool instance is visible yet.
    autoWinSetStatus(tostring(id) .. " purchase sent - continuing")
    task.wait(0.25)
    return false
end

local function autoWinMaxUpgrade(id, runId, statusText)
    autoWinSetStatus(statusText)

    local count = 0
    local idleDeadline = os.clock() + 8

    while count < AUTO_WIN_MAX_UPGRADE_ATTEMPTS
        and os.clock() < idleDeadline do

        if not autoWinEnabled or runId ~= autoWinRunId then
            return false
        end

        if autoWinCheckPriority(runId) then
            return true
        end

        if autoWinBg.smartBuy(BuyUpgradeRemote, id) then
            count += 1
            idleDeadline = os.clock() + 8
            task.wait(AUTO_WIN_STEP_DELAY)
        else
            task.wait(0.15)
        end
    end

    return false
end

local function stopAutoWinWorkers()
    if vacuumStarted and VacuumAction then
        pcall(function()
            VacuumAction:FireServer("Stop")
        end)
        vacuumStarted = false
    end

    needleAuto = false
    autoSellHay = false
    autoTNT = false
    autoCollectHay = false
    autoTPHay = false
    tntBusy = false
    lastTPHayTarget = nil

    resetTntState()
end

local function runAutoWin(runId)
    if autoWinRunning then
        return
    end

    autoWinRunning = true

    -- These stay active for the whole run unless the needle has priority.
    needleAuto = true
    autoSellHay = true
    autoCollectHay = true
    autoTPHay = true
    autoTNT = true

    refreshHayTools()
    restartHayVacuum()
    startAutoNeedleLoop()

    -- Tools + upgrades are bought in the background from the very start.
    autoWinBg.start()

    autoWinSetStatus("Running - buying in background")

    -- Buying follows the ordered money plan in the background; this loop
    -- only makes sure the Needle gets delivered, again and again.
    while autoWinEnabled and runId == autoWinRunId do
        if autoWinIsNeedlePresent() then
            if autoWinHandleNeedle(runId) then
                autoWinSetStatus("Needle delivered - waiting for next")
            end
        end

        task.wait(0.25)
    end

    autoWinRunning = false

    if autoWinEnabled and runId == autoWinRunId then
        autoWinSetStatus("Needle delivered - complete")
    else
        autoWinSetStatus("Stopped")
    end
end

