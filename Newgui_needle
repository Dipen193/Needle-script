local lagFixed = false

makeToggle(
    settingsCard,
    "Fix Lag",
    1,
    function(on)
        if on and not lagFixed then
            lagFixed = true

            pcall(function()
                setfpscap(60)
            end)

            pcall(function()
                local L =
                    game:GetService(
                        "Lighting"
                    )

                L.GlobalShadows = false
                L.Technology =
                    Enum.Technology.Compatibility

                L.FogEnd = 1000000
                L.Brightness = 0
                L.ClockTime = 12
                L.GeographicLatitude = 0

                for _, v in pairs(
                    L:GetChildren()
                ) do
                    if v:IsA("PostEffect")
                        or v:IsA("Atmosphere")
                        or v:IsA("Sky") then

                        if v:IsA("Sky") then
                            v.StarCount = 0
                        else
                            v:Destroy()
                        end

                        pcall(function()
                            v.Enabled = false
                        end)
                    end
                end

                local T =
                    workspace:FindFirstChildOfClass(
                        "Terrain"
                    )

                if T then
                    T.WaterWaveSize = 0
                    T.WaterWaveSpeed = 0
                    T.WaterReflectance = 0
                    T.WaterTransparency = 1

                    pcall(function()
                        T.Decoration = false
                    end)
                end

                local function clear(v)
                    if v:IsA("ParticleEmitter")
                        or v:IsA("Trail")
                        or v:IsA("Beam")
                        or v:IsA("Smoke")
                        or v:IsA("Fire")
                        or v:IsA("Sparkles") then

                        v.Enabled = false
                        v:Destroy()

                    elseif v:IsA("Decal")
                        or v:IsA("Texture") then

                        v.Transparency = 1
                        v:Destroy()

                    elseif v:IsA("BasePart") then
                        v.CastShadow = false
                        v.Reflectance = 0
                        v.Material =
                            Enum.Material.SmoothPlastic

                    elseif v:IsA("MeshPart") then
                        v.RenderFidelity =
                            Enum.RenderFidelity.Performance

                        v.CastShadow = false

                    elseif v:IsA("Accessory")
                        and not v.Parent:IsA("Tool") then

                        pcall(function()
                            if game.Players:GetPlayerFromCharacter(
                                v.Parent
                            )
                                ~= game.Players.LocalPlayer then

                                v:Destroy()
                            end
                        end)
                    end
                end

                for _, v in pairs(
                    game:GetDescendants()
                ) do
                    pcall(clear, v)
                end

                game.DescendantAdded:Connect(
                    function(v)
                        task.wait(0.1)
                        pcall(clear, v)
                    end
                )

                settings().Rendering.QualityLevel =
                    Enum.QualityLevel.Level01
            end)
        end
    end
)

